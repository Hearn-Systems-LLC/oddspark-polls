---
import ButtonDestructive from "./button-destructive.astro";
import ButtonSecondary from "./button-secondary.astro";
import Overlay from "./overlay.astro";
import { formatUtc } from "../lib/datetime";
import {
  COMMENT_COPY,
  isCommentTimestamp,
  type AdministratorCommentView,
  type CommentView,
  type OwnerCommentView,
} from "../modules/comments/index";

interface Props {
  comments: CommentView[];
  moderationComments?:
    | OwnerCommentView[]
    | AdministratorCommentView[]
    | null;
  csrfToken?: string;
  cancelHref: string;
  mode?: "owner" | "administrator";
}

const {
  comments,
  moderationComments = null,
  csrfToken = "",
  cancelHref,
  mode = "owner",
} = Astro.props;
const canModerate =
  moderationComments !== null &&
  moderationComments.length === comments.length &&
  csrfToken.length > 0;
if (comments.some((comment) => !isCommentTimestamp(comment.createdAtMs))) {
  throw new Error("Malformed Comment timestamp");
}
---

{
  comments.length > 0 && (
    <section class="comment-list" aria-labelledby="comments-heading" data-comment-list>
      <h2 id="comments-heading">{COMMENT_COPY.heading}</h2>
      <ol role="list">
        {comments.map((comment, index) => {
          const moderation = canModerate ? moderationComments?.[index] : undefined;
          const overlayId = moderation
            ? `delete-comment-${moderation.commentId}`
            : null;
          const deleteLabel = `${COMMENT_COPY.delete} ${index + 1} OF ${comments.length}`;
          return (
            <li
              data-comment-item
              data-comment-created-at-ms={comment.createdAtMs}
            >
              <p class="comment-body" data-comment-body>{comment.body}</p>
              <p class="comment-byline">
                <span
                  data-comment-display-name
                  data-comment-anonymous={comment.displayName === null ? "true" : undefined}
                >
                  {comment.displayName ?? COMMENT_COPY.anonymous}
                </span>
                <span aria-hidden="true"> · </span>
                <time datetime={new Date(comment.createdAtMs).toISOString()}>
                  {formatUtc(comment.createdAtMs)}
                </time>
              </p>
              {moderation && overlayId && (
                <div class="comment-moderation" data-comment-moderation>
                  <ButtonSecondary
                    href={`#${overlayId}`}
                    class="comment-delete-invoker"
                    hidden
                    aria-haspopup="dialog"
                    aria-controls={overlayId}
                    aria-expanded="false"
                    aria-label={deleteLabel}
                    data-overlay-open-for={overlayId}
                  >
                    {COMMENT_COPY.delete}
                  </ButtonSecondary>
                  <details class="comment-delete-nojs" data-comment-delete-nojs>
                    <summary aria-label={deleteLabel}>{COMMENT_COPY.delete}</summary>
                    <p>{COMMENT_COPY.deleteDescription}</p>
                    <form method="post" action="/creator/comments/delete">
                      <input type="hidden" name="mode" value={mode} />
                      <input type="hidden" name="comment_id" value={moderation.commentId} />
                      <input type="hidden" name="csrf_token" value={csrfToken} />
                      <ButtonDestructive type="submit" aria-label={deleteLabel}>{COMMENT_COPY.delete}</ButtonDestructive>
                    </form>
                  </details>
                  <Overlay
                    id={overlayId}
                    titleId={`${overlayId}-title`}
                    descriptionId={`${overlayId}-description`}
                    title={COMMENT_COPY.deleteTitle}
                  >
                    <p slot="description">{COMMENT_COPY.deleteDescription}</p>
                    <ButtonSecondary
                      slot="actions"
                      href={cancelHref}
                      data-overlay-cancel
                    >
                      CANCEL
                    </ButtonSecondary>
                    <form
                      slot="actions"
                      method="post"
                      action="/creator/comments/delete"
                      data-comment-delete-form
                      data-pending-label="DELETING…"
                    >
                      <input type="hidden" name="mode" value={mode} />
                      <input type="hidden" name="comment_id" value={moderation.commentId} />
                      <input type="hidden" name="csrf_token" value={csrfToken} />
                      <ButtonDestructive type="submit" aria-label={deleteLabel}>{COMMENT_COPY.delete}</ButtonDestructive>
                    </form>
                  </Overlay>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  .comment-list {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: var(--space-hairline) solid var(--color-rule);
  }

  h2 {
    margin: 0 0 var(--space-6);
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-lg-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
  }

  ol {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }

  li {
    min-width: 0;
    list-style: none;
  }

  .comment-body {
    margin: 0;
    font-family: var(--font-human);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-lh);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .comment-byline {
    margin: var(--space-2) 0 0;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .comment-moderation {
    margin-top: var(--space-3);
  }

  .comment-delete-nojs summary {
    width: fit-content;
    min-height: 44px;
    color: var(--color-alarm);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    font-weight: 700;
    line-height: 44px;
    letter-spacing: var(--type-label-caps-ls);
    cursor: pointer;
  }

  .comment-delete-nojs p {
    margin: var(--space-2) 0 var(--space-3);
  }
</style>
