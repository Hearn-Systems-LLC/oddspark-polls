---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: boolean;
  /** id of the inline error message element, wired to aria-describedby. */
  describedby?: string;
  /** Mobile/browser hint pass-throughs for machine-shaped values (slugs, codes). */
  autocapitalize?: "none" | "sentences" | "words" | "characters" | "off" | "on";
  spellcheck?: "true" | "false";
  autocomplete?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  value = "",
  placeholder = "",
  required = false,
  disabled = false,
  error = false,
  describedby,
  autocapitalize,
  spellcheck,
  autocomplete,
  class: className = "",
} = Astro.props;
---

<div class:list={["field", className]}>
  <label class="label-caps field-label" for={id}>{label}</label>
  <input
    class:list={["field-input", error && "is-error"]}
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocapitalize={autocapitalize}
    spellcheck={spellcheck}
    autocomplete={autocomplete}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedby}
  />
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field-label {
    display: block;
  }

  .field-input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) 0;
    border: none;
    border-bottom: var(--input-border-bottom);
    border-radius: var(--rounded-default);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .field-input::placeholder {
    color: var(--input-placeholder);
  }

  .field-input:focus {
    outline: none;
    border-bottom: var(--input-border-bottom-focus);
  }

  .field-input:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .field-input.is-error {
    border-bottom: var(--input-border-bottom-error);
  }
</style>
