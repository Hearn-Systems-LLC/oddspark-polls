<style>
  /* DESIGN.md §landing-footer: full shell width below the grid, one top
     hairline at section-gap distance, byline left / Landing nav right. */
  .landing-footer { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: var(--space-section-gap); border-top: var(--space-hairline) solid var(--color-rule); }
  .landing-footer-byline { display: inline-flex; align-items: baseline; min-height: 44px; color: var(--color-dim); font-family: var(--font-machine); font-size: var(--type-body-size); line-height: var(--type-body-lh); text-decoration: none; }
  .landing-footer-byline:hover { color: var(--color-text); }
  .landing-footer-byline:focus-visible { outline: var(--focus-outline); outline-offset: var(--focus-outline-offset); }
  .landing-footer-byline svg { height: 0.78em; width: auto; align-self: baseline; margin-left: calc(var(--space-1) + 2px); /* a replaced element's flex baseline is its bottom margin edge, so baseline alignment sets the wordmark's glyph bottom exactly on the text baseline */ }
  .landing-footer-nav { display: flex; gap: var(--space-8); }
  .landing-footer-link { display: inline-flex; align-items: center; min-height: 48px; color: var(--color-entropy); text-decoration: none; }
  .landing-footer-link:hover { color: var(--color-text); }
  .landing-footer-link:focus-visible { outline: var(--focus-outline); outline-offset: var(--focus-outline-offset); }
  /* The shared repository link keeps a standalone margin for its Poll-footer
     surface; inside the footer row it aligns on the same line as its
     neighbours. Scoped styles cannot reach the child component, so the
     descendant is global. */
  .landing-footer :global(.public-repository-link.is-landing) { margin-top: 0; }
  /* Below sm the row wraps: byline holds the first line, the three links
     stack beneath it left-aligned at 48px targets. Nothing rearranged. */
  @media (max-width: 639px) { .landing-footer-nav { flex: 0 0 100%; flex-direction: column; gap: 0; align-items: flex-start; } }
</style>
