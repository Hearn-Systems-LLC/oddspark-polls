---
/**
 * Reusable confirmation overlay (Story 1.12 completes focus trap / dismiss).
 * Always render the dialog DOM so JS can open it without a navigation; when
 * `open` is false it is hidden and inert / removed from the a11y tree.
 */
interface Props {
  open?: boolean;
  id: string;
  titleId: string;
  descriptionId: string;
  title: string;
  class?: string;
}

const {
  open = false,
  id,
  titleId,
  descriptionId,
  title,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["overlay", className, { "is-open": open }]}
  id={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
  data-overlay
  data-overlay-open={open ? "true" : "false"}
  hidden={!open}
  inert={!open ? true : undefined}
>
  <div class="overlay-scrim" data-overlay-scrim></div>
  <div class="overlay-panel" data-overlay-panel>
    <h2 class="overlay-title" id={titleId}>{title}</h2>
    <div class="overlay-body" id={descriptionId}>
      <slot name="description" />
    </div>
    <div class="overlay-actions">
      <slot name="actions" />
    </div>
  </div>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: var(--space-margin-mobile);
  }

  .overlay[hidden] {
    display: none;
  }

  .overlay-scrim {
    position: absolute;
    inset: 0;
    background: var(--overlay-scrim);
  }

  .overlay-panel {
    position: relative;
    z-index: 1;
    width: min(100%, 28rem);
    background: var(--color-panel);
    /* DESIGN.md overlay body: single top and bottom hairline, never a box */
    border-top: var(--space-hairline) solid var(--color-rule);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    border-radius: var(--rounded-default);
    padding: var(--space-6) var(--space-5);
  }

  .overlay-title {
    /* DESIGN.md: title in heading-md (Newsreader 19px), not label-caps */
    font-family: var(--font-human);
    font-size: var(--type-heading-md-size);
    font-weight: 400;
    line-height: var(--type-heading-md-lh);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .overlay-body {
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }

  .overlay-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }
</style>
