---
/**
 * Shared Poll definition fields for create + edit (Stories 1.12 / 5.1).
 * Parent form owns CSRF, intent, and non-definition fields.
 */
import Input from "./input.astro";
import ButtonSecondary from "./button-secondary.astro";
import PollOption from "./poll-option.astro";
import { RENDER_OPTION_CEILING } from "../modules/polls/caps";

interface Props {
  values: {
    pollType?: string;
    question: string;
    description: string;
    options: string[];
    slots?: { date: string; start: string; end: string }[];
    timeZone?: string;
    multiSelect: string;
    minSelections: string;
    maxSelections: string;
    commentsEnabled?: string;
  };
  fieldErrors?: Record<string, string>;
  optionNote?: string | null;
  slotNote?: string | null;
  pollTypeLabel?: string;
  showPollType?: boolean;
  pollTypeEditable?: boolean;
  showDescription?: boolean;
  /** When true, question/options/multi-select render read-only. */
  locked?: boolean;
  lockMessage?: string | null;
  lockedSlots?: string[];
  lockedTimeZone?: string | null;
  /** Label for the primary save submit (edit only; create uses external publish). */
  saveLabel?: string | null;
  showSave?: boolean;
  /** Image Poll temp media entries for re-render preservation (Story 6.1). */
  tempMedia?: {
    mediaId: string;
    r2Key: string;
    contentType: string;
    sizeBytes: number;
    altText: string;
    caption: string;
  }[];
  /** In-flight form nonce — scopes creator preview URLs for unadopted media. */
  pollId?: string;
}

const {
  values,
  fieldErrors = {},
  optionNote = null,
  slotNote = null,
  pollTypeLabel = "MULTIPLE CHOICE",
  showPollType = true,
  pollTypeEditable = false,
  showDescription = true,
  locked = false,
  lockMessage = null,
  lockedSlots = [],
  lockedTimeZone = null,
  saveLabel = "SAVE CHANGES",
  showSave = false,
  tempMedia = [],
  pollId = "",
} = Astro.props;

const MULTI_SELECT_CHOICES = [
  { value: "false", label: "ONE" },
  { value: "true", label: "SEVERAL" },
] as const;
const POLL_TYPE_CHOICES = [
  {
    value: "multiple_choice",
    label: "MULTIPLE CHOICE",
    description: "Voters pick one option, or several when enabled.",
  },
  {
    value: "ranked_choice",
    label: "RANKED CHOICE",
    description: "Voters rank any non-empty subset in preference order.",
  },
  {
    value: "image",
    label: "IMAGE",
    description: "Each option is a picture. Voters pick their favorite.",
  },
  {
    value: "meeting",
    label: "MEETING",
    description: "Propose concrete times for the group to consider.",
  },
] as const;
const pollType = values.pollType ?? "multiple_choice";
const rankedChoice = pollType === "ranked_choice";
const imagePoll = pollType === "image";
const meetingPoll = pollType === "meeting";
---

{
  showSave && locked && (
    <div class="save-block save-block-end">
      <ButtonSecondary type="submit" name="intent" value="update-description">
        SAVE DESCRIPTION
      </ButtonSecondary>
    </div>
  )
}

{
  showSave && !locked && (
    <div class="save-block save-block-end">
      <ButtonSecondary type="submit" name="intent" value="update-definition">
        {saveLabel}
      </ButtonSecondary>
    </div>
  )
}

{
  showPollType && (
    <div class="field-block">
      {pollTypeEditable ? (
        <fieldset aria-describedby={fieldErrors.pollType ? "poll-type-error" : undefined}>
          <legend class="group-label">POLL TYPE</legend>
          <div class="multi-select-choices" data-poll-type-choices>
            {POLL_TYPE_CHOICES.map((choice) => (
              <PollOption
                id={`poll-type-${choice.value}`}
                name="pollType"
                value={choice.value}
                label={choice.label}
                description={choice.description}
                checked={pollType === choice.value}
              />
            ))}
          </div>
          {fieldErrors.pollType && (
            <p class="field-error" id="poll-type-error">{fieldErrors.pollType}</p>
          )}
        </fieldset>
      ) : (
        <>
          <p class="group-label">POLL TYPE</p>
          <p class="read-only-value" data-poll-type>{pollTypeLabel}</p>
          <input type="hidden" name="pollType" value={pollType} />
        </>
      )}
    </div>
  )
}

{
  locked ? (
    <>
      {lockMessage && (
        <p class="lock-line" data-definition-locked>
          {lockMessage}
        </p>
      )}
      <div class="field-block">
        <p class="group-label">QUESTION</p>
        <p class="read-only-value" data-locked-question>
          {values.question}
        </p>
      </div>
      <div class="field-block">
        <p class="group-label">{meetingPoll ? "TIME SLOTS" : "OPTIONS"}</p>
        {meetingPoll && (
          <p class="label-caps-lg" data-timezone-line>
            TIMES IN {lockedTimeZone || "UTC"}
          </p>
        )}
        <ol class="locked-options" data-locked-options>
          {(meetingPoll
            ? lockedSlots
            : values.options.filter((option) => option.trim().length > 0)
          ).map((value) => <li>{value}</li>)}
        </ol>
      </div>
      {!rankedChoice && !meetingPoll && (
        <div class="field-block">
          <p class="group-label">HOW MANY OPTIONS CAN A VOTER PICK</p>
          <p class="read-only-value">
            {values.multiSelect === "true" ? "SEVERAL" : "ONE"}
            {values.multiSelect === "true" && (
                <span>
                  {" "}
                  (min {values.minSelections || "1"}, max{" "}
                  {values.maxSelections || values.options.filter((option) => option.trim().length > 0).length})
                </span>
              )}
          </p>
        </div>
      )}
      <div class="field-block">
        <p class="group-label">COMMENTS WITH VOTES</p>
        <p class="read-only-value">
          {values.commentsEnabled === "true" ? "ENABLED" : "DISABLED"}
        </p>
      </div>
    </>
  ) : (
    <>
      <div class="field-block">
        <Input
          id="question"
          name="question"
          label="QUESTION"
          value={values.question}
          error={Boolean(fieldErrors.question)}
          describedby={fieldErrors.question ? "question-error" : undefined}
        />
        {fieldErrors.question && (
          <p class="field-error" id="question-error">
            {fieldErrors.question}
          </p>
        )}
      </div>

      <fieldset
        class="field-block options-block"
        data-options-fields
        hidden={meetingPoll}
        aria-invalid={fieldErrors.options ? "true" : undefined}
        aria-describedby={fieldErrors.options ? "options-error" : undefined}
      >
        <legend class="group-label">OPTIONS</legend>
        <div data-option-list>
          {values.options
            .slice(0, RENDER_OPTION_CEILING)
            .map((option, index) => (
              <div class="option-row" data-option-row>
                <Input
                  id={`option-${index + 1}`}
                  name={meetingPoll ? undefined : "option"}
                  label={`OPTION ${index + 1}`}
                  value={option}
                  disabled={meetingPoll}
                />
                <div class="image-upload-fields" data-image-upload-fields hidden={!imagePoll}>
                  <div class="image-file-row">
                    <label class="group-label" for={`media-file-${index}`}>
                      IMAGE
                    </label>
                    <input
                      type="file"
                      id={`media-file-${index}`}
                      name={imagePoll ? `media_file_${index}` : undefined}
                      accept="image/jpeg,image/png,image/webp"
                      disabled={!imagePoll}
                      aria-describedby={
                        fieldErrors[`media[${index}]`]
                          ? `media-${index}-error`
                          : undefined
                      }
                    />
                    {tempMedia[index] && (
                      <>
                        <input
                          type="hidden"
                          name="media_ref"
                          value={`${index}:${tempMedia[index].mediaId}`}
                        />
                        <div class="image-preview-plate">
                          <img
                            src={`/creator/media/${tempMedia[index].mediaId}?poll=${encodeURIComponent(pollId)}`}
                            alt={tempMedia[index].altText || "Uploaded preview"}
                            width="120"
                            height="120"
                          />
                        </div>
                      </>
                    )}
                    {fieldErrors[`media[${index}]`] && (
                      <p class="field-error" id={`media-${index}-error`}>
                        {fieldErrors[`media[${index}]`]}
                      </p>
                    )}
                  </div>
                  <div class="field-block">
                    <Input
                      id={`media-alt-${index}`}
                      name={imagePoll ? `media_alt_${index}` : undefined}
                      label="ALT TEXT"
                      value={tempMedia[index]?.altText ?? ""}
                      disabled={!imagePoll}
                      error={Boolean(fieldErrors[`media[${index}].altText`])}
                      describedby={
                        fieldErrors[`media[${index}].altText`]
                          ? `media-alt-${index}-error`
                          : undefined
                      }
                    />
                    {fieldErrors[`media[${index}].altText`] && (
                      <p class="field-error" id={`media-alt-${index}-error`}>
                        {fieldErrors[`media[${index}].altText`]}
                      </p>
                    )}
                  </div>
                  <div class="field-block">
                    <Input
                      id={`media-caption-${index}`}
                      name={imagePoll ? `media_caption_${index}` : undefined}
                      label="CAPTION (OPTIONAL)"
                      value={tempMedia[index]?.caption ?? ""}
                      disabled={!imagePoll}
                    />
                  </div>
                </div>
              </div>
            ))}
        </div>
        {fieldErrors.options && (
          <p class="field-error" id="options-error">
            {fieldErrors.options}
          </p>
        )}
        <div class="add-option">
          <ButtonSecondary type="submit" name="intent" value="add-option">
            ADD OPTION
          </ButtonSecondary>
          {optionNote && <p class="helper-note">{optionNote}</p>}
          <p class="helper-note">Blank options are dropped when you save.</p>
        </div>
      </fieldset>

      <fieldset
        class="field-block options-block"
        data-meeting-slot-fields
        hidden={!meetingPoll}
        aria-invalid={fieldErrors.slots ? "true" : undefined}
        aria-describedby={fieldErrors.slots ? "slots-error" : undefined}
      >
        <legend class="group-label">TIME SLOTS</legend>
        <p class="label-caps-lg" data-timezone-line>
          TIMES IN {values.timeZone?.trim() || "UTC"}
        </p>
        <div data-slot-list>
          {(values.slots ?? []).map((slot, index) => (
            <div class="option-row slot-row" data-slot-row>
              <Input
                id={`slot-date-${index}`}
                name={meetingPoll ? `slot_date_${index}` : undefined}
                label={`SLOT ${index + 1} DATE`}
                type="date"
                value={slot.date}
                disabled={!meetingPoll}
              />
              <Input
                id={`slot-start-${index}`}
                name={meetingPoll ? `slot_start_${index}` : undefined}
                label="START"
                type="time"
                value={slot.start}
                disabled={!meetingPoll}
              />
              <Input
                id={`slot-end-${index}`}
                name={meetingPoll ? `slot_end_${index}` : undefined}
                label="END"
                type="time"
                value={slot.end}
                disabled={!meetingPoll}
              />
              {fieldErrors[`slots[${index}]`] && (
                <p class="field-error" id={`slot-${index}-error`}>
                  {fieldErrors[`slots[${index}]`]}
                </p>
              )}
            </div>
          ))}
        </div>
        {fieldErrors.slots && (
          <p class="field-error" id="slots-error">{fieldErrors.slots}</p>
        )}
        <div class="add-option">
          <ButtonSecondary type="submit" name="intent" value="add-slot">
            ADD SLOT
          </ButtonSecondary>
          {slotNote && <p class="helper-note">{slotNote}</p>}
          <p class="helper-note">Blank slots are dropped when you save.</p>
        </div>
      </fieldset>

      <fieldset
        class="field-block"
        data-multiple-choice-fields
        hidden={rankedChoice || imagePoll || meetingPoll}
        aria-invalid={fieldErrors.multiSelect ? "true" : undefined}
        aria-describedby={
          fieldErrors.multiSelect ? "multi-select-error" : undefined
        }
      >
        <legend class="group-label">HOW MANY OPTIONS CAN A VOTER PICK</legend>
        <div class="multi-select-choices">
          {MULTI_SELECT_CHOICES.map((choice) => (
            <PollOption
              id={`multi-select-${choice.value}`}
              name="multiSelect"
              value={choice.value}
              label={choice.label}
              checked={values.multiSelect === choice.value}
              disabled={rankedChoice || imagePoll || meetingPoll}
            />
          ))}
        </div>
        {fieldErrors.multiSelect && (
          <p class="field-error" id="multi-select-error">
            {fieldErrors.multiSelect}
          </p>
        )}
        <div
          class="multi-select-bounds"
          data-multi-select-bounds
          data-has-bounds-error={Boolean(
            fieldErrors.minSelections || fieldErrors.maxSelections,
          )}
        >
          <div class="field-block">
            <Input
              id="min-selections"
              name="minSelections"
              label="MIN (OPTIONAL)"
              type="number"
              value={values.minSelections}
              disabled={rankedChoice || imagePoll || meetingPoll}
              error={Boolean(fieldErrors.minSelections)}
              describedby={
                fieldErrors.minSelections
                  ? "min-selections-error multi-select-bounds-help"
                  : "multi-select-bounds-help"
              }
            />
            {fieldErrors.minSelections && (
              <p class="field-error" id="min-selections-error">
                {fieldErrors.minSelections}
              </p>
            )}
          </div>
          <div class="field-block">
            <Input
              id="max-selections"
              name="maxSelections"
              label="MAX (OPTIONAL)"
              type="number"
              value={values.maxSelections}
              disabled={rankedChoice || imagePoll || meetingPoll}
              error={Boolean(fieldErrors.maxSelections)}
              describedby={
                fieldErrors.maxSelections
                  ? "max-selections-error multi-select-bounds-help"
                  : "multi-select-bounds-help"
              }
            />
            {fieldErrors.maxSelections && (
              <p class="field-error" id="max-selections-error">
                {fieldErrors.maxSelections}
              </p>
            )}
          </div>
          <p class="helper-note" id="multi-select-bounds-help">
            Leave blank for 1 to all options.
          </p>
        </div>
      </fieldset>

      <fieldset class="field-block">
        <legend class="group-label">COMMENTS WITH VOTES</legend>
        <div class="multi-select-choices">
          <PollOption
            id="comments-disabled"
            name="commentsEnabled"
            value="false"
            label="DISABLED"
            checked={values.commentsEnabled !== "true"}
          />
          <PollOption
            id="comments-enabled"
            name="commentsEnabled"
            value="true"
            label="ENABLED"
            description="Voters may attach one optional Comment and display name."
            checked={values.commentsEnabled === "true"}
          />
        </div>
      </fieldset>
    </>
  )
}

{
  showDescription && (
    <div class="field-block">
      <label class="group-label" for="description">DESCRIPTION (OPTIONAL)</label>
      <textarea
        class:list={[
          "description-input",
          fieldErrors.description && "is-error",
        ]}
        id="description"
        name="description"
        rows="4"
        aria-invalid={fieldErrors.description ? "true" : undefined}
        aria-describedby={
          fieldErrors.description ? "description-error" : undefined
        }
      >{values.description}</textarea>
      {
        fieldErrors.description && (
          <p class="field-error" id="description-error">
            {fieldErrors.description}
          </p>
        )
      }
    </div>
  )
}

<style>
  .field-block {
    display: grid;
    gap: var(--space-2);
  }

  .field-block[hidden] {
    display: none;
  }

  .group-label {
    display: block;
    padding: 0;
    margin: 0;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: none;
  }

  .options-block [data-option-list] {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .option-row {
    display: grid;
    gap: var(--space-2);
  }

  .option-row :global(.option-remove) {
    justify-self: start;
    padding: var(--space-1) 0;
    border: none;
    background: transparent;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
  }

  .option-row :global(.option-remove:focus-visible) {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .add-option {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    justify-items: start;
  }

  .multi-select-choices {
    margin-top: var(--space-3);
  }

  .multi-select-bounds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .multi-select-bounds[hidden] {
    display: none;
  }

  .multi-select-bounds .helper-note {
    grid-column: 1 / -1;
  }

  .description-input {
    width: 100%;
    padding: var(--space-2) 0;
    border: none;
    border-bottom: var(--input-border-bottom);
    border-radius: var(--rounded-default);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    resize: vertical;
  }

  .description-input:focus {
    outline: none;
    border-bottom: var(--input-border-bottom-focus);
  }

  .description-input:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .description-input.is-error {
    border-bottom: var(--input-border-bottom-error);
  }

  .field-error {
    margin: 0;
    color: var(--color-alarm);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .helper-note {
    margin: 0;
    color: var(--color-dim);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .read-only-value {
    margin: 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .locked-options {
    margin: 0;
    padding-inline-start: 1.25rem;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .lock-line {
    margin: 0 0 var(--space-4);
    color: var(--color-text);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .save-block {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .save-block-end {
    order: 10;
  }

  .image-upload-fields {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-rule);
  }

  .image-upload-fields[hidden] {
    display: none;
  }

  .image-file-row {
    display: grid;
    gap: var(--space-2);
  }

  .image-preview-plate {
    width: 120px;
    height: 120px;
    overflow: hidden;
    border-radius: 0;
  }

  .image-preview-plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
