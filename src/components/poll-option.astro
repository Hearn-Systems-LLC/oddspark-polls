---
interface Props {
  id: string;
  name: string;
  value: string;
  label: string;
  /** Consequence line beneath the label (DESIGN.md: the Visibility chooser
   * rows on the creator surface each carry one). */
  description?: string;
  checked?: boolean;
  type?: "radio" | "checkbox";
  readOnly?: boolean;
  class?: string;
}

const {
  id,
  name,
  value,
  label,
  description,
  checked = false,
  type = "radio",
  readOnly = false,
  class: className = "",
} = Astro.props;
---

{
  readOnly ? (
    <div class:list={["poll-option", "poll-option-readonly", className]}>
      <span class="poll-option-text">
        <span class="poll-option-label">{label}</span>
        {description && <span class="poll-option-description">{description}</span>}
      </span>
    </div>
  ) : (
    <label class:list={["poll-option", className]} for={id}>
      <input
        class="visually-hidden poll-option-input"
        type={type}
        id={id}
        name={name}
        value={value}
        checked={checked}
      />
      <span class="poll-option-marker" aria-hidden="true"></span>
      <span class="poll-option-text">
        <span class="poll-option-label">{label}</span>
        {description && <span class="poll-option-description">{description}</span>}
      </span>
    </label>
  )
}

<style>
  .poll-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    border-radius: var(--rounded-default);
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    cursor: pointer;
  }

  .poll-option:hover {
    background: var(--poll-option-hover-bg);
  }

  .poll-option-readonly {
    cursor: default;
  }

  .poll-option-readonly:hover {
    background: transparent;
  }

  .poll-option:focus-within {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .poll-option-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .poll-option-description {
    color: var(--color-dim);
  }

  .poll-option-marker {
    flex-shrink: 0;
    width: 14px;
    color: var(--poll-option-marker);
    text-align: center;
    position: relative;
  }

  .poll-option-marker::before {
    content: "·";
  }

  .poll-option-input:checked + .poll-option-marker::before {
    content: "◆";
    color: var(--poll-option-marker-selected);
  }
</style>
