---
interface Props {
  id: string;
  name: string;
  value: string;
  label: string;
  checked?: boolean;
  type?: "radio" | "checkbox";
  class?: string;
}

const {
  id,
  name,
  value,
  label,
  checked = false,
  type = "radio",
  class: className = "",
} = Astro.props;
---

<label class:list={["poll-option", className]} for={id}>
  <input
    class="visually-hidden poll-option-input"
    type={type}
    id={id}
    name={name}
    value={value}
    checked={checked}
  />
  <span class="poll-option-marker" aria-hidden="true"></span>
  <span class="poll-option-label">{label}</span>
</label>

<style>
  .poll-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    border-radius: var(--rounded-default);
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    cursor: pointer;
  }

  .poll-option:hover {
    background: var(--poll-option-hover-bg);
  }

  .poll-option:focus-within {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .poll-option-marker {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border: var(--space-hairline) solid var(--poll-option-marker);
    border-radius: var(--rounded-default);
    position: relative;
  }

  .poll-option-marker::before {
    content: "";
    position: absolute;
    inset: 2px;
    background: transparent;
  }

  .poll-option-input:checked + .poll-option-marker {
    border-color: var(--poll-option-marker-selected);
  }

  .poll-option-input:checked + .poll-option-marker::before {
    background: var(--poll-option-marker-selected);
  }
</style>
