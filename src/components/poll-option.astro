---
interface Props {
  id: string;
  name: string;
  value: string;
  label: string;
  /** Consequence line beneath the label (DESIGN.md: the Visibility chooser
   * rows on the creator surface each carry one). */
  description?: string;
  checked?: boolean;
  type?: "radio" | "checkbox";
  readOnly?: boolean;
  disabled?: boolean;
  class?: string;
  /** Story 6.2 — adopted image plate for Image Poll options. When present,
   * the plate replaces the label text inside `.poll-option-text`; the
   * caption renders below the plate in `{typography.caption}` only when
   * non-null. The native input + marker gutter stay exactly as-is so the
   * tap target and accessible name algorithm are unchanged. */
  media?: { mediaId: string; altText: string; caption: string | null };
}

const {
  id,
  name,
  value,
  label,
  description,
  checked = false,
  type = "radio",
  readOnly = false,
  disabled = false,
  class: className = "",
  media,
} = Astro.props;
---

{
  readOnly ? (
    <div
      class:list={[
        "poll-option",
        "poll-option-readonly",
        media && "poll-option-image",
        type === "checkbox" && "poll-option-checkbox",
        className,
      ]}
    >
      {/* UX-DR2: the voter's own cast selection is marked with ◆ for radio
          rows and [×] for checkbox rows. The marker span renders on EVERY
          read-only row so alignment is stable; the glyph is aria-hidden, so
          the cast row also carries visually-hidden text a screen reader can
          announce. */}
      <span
        class:list={["poll-option-marker", checked && "is-cast"]}
        aria-hidden="true"
      ></span>
      <span class="poll-option-text">
        {checked && <span class="visually-hidden">Your vote</span>}
        {media ? (
          <>
            <img
              class="poll-option-plate"
              src={`/media/${media.mediaId}`}
              alt={media.altText}
              loading="lazy"
              decoding="async"
            />
            {media.caption !== null && (
              <span class="poll-option-caption">{media.caption}</span>
            )}
          </>
        ) : (
          <>
            <span class="poll-option-label">{label}</span>
            {description && <span class="poll-option-description">{description}</span>}
          </>
        )}
      </span>
    </div>
  ) : (
    <label class:list={["poll-option", media && "poll-option-image", className]} for={id}>
      <input
        class="visually-hidden poll-option-input"
        type={type}
        id={id}
        name={name}
        value={value}
        checked={checked}
        disabled={disabled}
      />
      <span class="poll-option-marker" aria-hidden="true"></span>
      <span class="poll-option-text">
        {media ? (
          <>
            <img
              class="poll-option-plate"
              src={`/media/${media.mediaId}`}
              alt={media.altText}
              loading="lazy"
              decoding="async"
            />
            {media.caption !== null && (
              <span class="poll-option-caption">{media.caption}</span>
            )}
          </>
        ) : (
          <>
            <span class="poll-option-label">{label}</span>
            {description && <span class="poll-option-description">{description}</span>}
          </>
        )}
      </span>
    </label>
  )
}

<style>
  .poll-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    border-radius: var(--rounded-default);
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    cursor: pointer;
  }

  /* Story 6.2: image plates sit at full column width and the marker needs
     to align with the top of the plate rather than the vertical center. */
  .poll-option-image {
    align-items: flex-start;
  }

  .poll-option:hover {
    background: var(--poll-option-hover-bg);
  }

  .poll-option-readonly {
    cursor: default;
  }

  .poll-option-readonly:hover {
    background: transparent;
  }

  .poll-option:focus-within {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .poll-option-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Story 6.2: square plate at full column width. aspect-ratio reserves
     layout before the image loads (no reflow, no motion); object-fit
     crops to the square without needing stored dimensions. */
  .poll-option-plate {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0;
  }

  /* Story 6.2: caption is option-identifying text (parallel to the label),
     so it uses the body-dark color rather than dim/faint. DESIGN.md bans
     faint on must-read text. */
  .poll-option-caption {
    color: var(--color-text);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .poll-option-description {
    color: var(--color-dim);
  }

  .poll-option-marker {
    flex-shrink: 0;
    width: 14px;
    color: var(--poll-option-marker);
    text-align: center;
    position: relative;
  }

  .poll-option-marker::before {
    content: "·";
  }

  .poll-option-input:checked + .poll-option-marker::before {
    content: "◆";
    color: var(--poll-option-marker-selected);
  }

  .poll-option-readonly .poll-option-marker.is-cast::before {
    content: "◆";
    color: var(--poll-option-marker-selected);
  }

  .poll-option-input[type="checkbox"] + .poll-option-marker,
  .poll-option-checkbox .poll-option-marker {
    width: 3ch;
  }

  .poll-option-input[type="checkbox"] + .poll-option-marker::before,
  .poll-option-checkbox .poll-option-marker::before {
    content: "[ ]";
  }

  .poll-option-input[type="checkbox"]:checked + .poll-option-marker::before,
  .poll-option-checkbox .poll-option-marker.is-cast::before {
    content: "[×]";
    color: var(--poll-option-marker-selected);
  }
</style>
