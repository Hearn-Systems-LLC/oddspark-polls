---
import TrustBadge from "./trust-badge.astro";
import type { RankedTallyView, RankedEliminationView } from "../modules/results/index";
import type { PollSecurityToggles, PollStatus } from "../shared/domain/index";
import { RESULTS_COPY } from "../modules/results/index";

type Props = {
  ranked: RankedTallyView;
  status: PollStatus;
  toggles?: PollSecurityToggles;
  liveEndpoint?: string;
  initialValidator?: string;
  initialRenderAtMs?: number;
  yourBallotLabels?: readonly string[];
  canonicalReference?: string;
};

const {
  ranked,
  status,
  toggles,
  liveEndpoint,
  initialValidator,
  initialRenderAtMs,
  yourBallotLabels,
  canonicalReference,
} = Astro.props;

const winnerLabel =
  ranked.winnerLabel && ranked.winnerLabel.trim().length > 0
    ? ranked.winnerLabel
    : "—";
const tiedLabels = ranked.tiedOptionLabels.map((label) =>
  label && label.trim().length > 0 ? label : "—",
);
const outcomeLine = ranked.empty
  ? RESULTS_COPY.empty
  : ranked.resolved
    ? `Winner: ${winnerLabel}`
    : tiedLabels.length > 0
      ? `Unresolved tie: ${tiedLabels.join(", ")}`
      : "Unresolved";

function eliminationStatement(
  elim: RankedEliminationView,
): string {
  const names = elim.labels.map((l) => (l.trim() ? l : "—"));
  switch (elim.reason) {
    case "fewest_votes":
      return `${names.join(", ")} had the fewest votes and was eliminated.`;
    case "safe_batch":
      return `${names.join(", ")} together held fewer votes than any remaining option and were eliminated as a group.`;
    case "backward_tie_break": {
      const round = elim.backwardTieBreakRound ?? "?";
      return `${names.join(", ")} were tied; the tie was broken by their counts in Round ${round}, where they had fewer votes.`;
    }
  }
}

const allOptionIds = ranked.rounds.length > 0
  ? ranked.rounds[0].counts.map((c) => c.optionId)
  : [];

function isEliminatedBeforeOrAt(
  optionId: string,
  roundIndex: number,
): boolean {
  for (let i = 0; i <= roundIndex; i++) {
    const elim = ranked.rounds[i]?.eliminated;
    if (elim && elim.optionIds.includes(optionId)) {
      return true;
    }
  }
  return false;
}

function isEliminatedBefore(optionId: string, roundIndex: number): boolean {
  for (let i = 0; i < roundIndex; i++) {
    const elim = ranked.rounds[i]?.eliminated;
    if (elim && elim.optionIds.includes(optionId)) {
      return true;
    }
  }
  return false;
}

function countForOption(
  optionId: string,
  roundIndex: number,
): number | null {
  const round = ranked.rounds[roundIndex];
  if (!round) return null;
  const entry = round.counts.find((c) => c.optionId === optionId);
  return entry ? entry.count : null;
}

const unresolvedCopy =
  !ranked.resolved && tiedLabels.length > 0 && ranked.rounds.length > 0
    ? `Unresolved at Round ${ranked.rounds.length}. ${tiedLabels.join(" and ")} are tied, and have been tied in every Round before this one. Rather than eliminate one at random, the count stops here. Standing counts below.`
    : null;
---

<section
  class="ranked-results"
  data-ranked-results
  data-results-region
  data-poll-type="ranked_choice"
  data-status={status}
  data-live-endpoint={liveEndpoint}
  data-initial-validator={initialValidator}
  data-initial-render-at={initialRenderAtMs}
  aria-label="Ranked-choice results"
>
  {toggles && <TrustBadge toggles={toggles} />}
  <p class="ranked-outcome" data-ranked-outcome aria-live="polite">
    {outcomeLine}
  </p>
  <p class="ranked-meta" data-ranked-meta>
    {ranked.voterCount === 1
      ? "1 BALLOT"
      : `${ranked.voterCount} BALLOTS`}
    {ranked.rounds.length > 0
      ? ` · ${ranked.rounds.length} ROUND${ranked.rounds.length === 1 ? "" : "S"}`
      : ""}
  </p>
  {yourBallotLabels && yourBallotLabels.length > 0 && (
    <p class="ranked-your-ballot" data-your-ballot>
      <span class="ranked-your-ballot-label">{RESULTS_COPY.yourBallot}</span>
      <span class="ranked-your-ballot-options">
        {yourBallotLabels.join(" > ")}
      </span>
    </p>
  )}
  {
    !ranked.empty && ranked.finalCounts.length > 0 && (
      <ol class="ranked-standing" data-ranked-standing>
        {ranked.finalCounts.map((option) => {
          const isWinner =
            ranked.resolved && ranked.winnerId === option.optionId;
          const isTied =
            !ranked.resolved &&
            ranked.tiedOptionIds.includes(option.optionId);
          return (
            <li
              class:list={[
                "ranked-standing-row",
                isWinner && "is-winner",
                isTied && "is-tied",
              ]}
              data-option-id={option.optionId}
            >
              <span class="ranked-standing-label">{option.label}</span>
              <span class="ranked-standing-count">{option.count}</span>
              {isWinner && (
                <span class="ranked-standing-mark">Winner</span>
              )}
              {isTied && (
                <span class="ranked-standing-mark">{RESULTS_COPY.tied}</span>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
  {unresolvedCopy && (
    <p class="ranked-unresolved-copy" data-ranked-unresolved>
      {unresolvedCopy}
    </p>
  )}
  {!ranked.empty && ranked.rounds.length > 0 && (
    <div class="round-table-scroll" data-round-table-scroll>
      <table class="round-table" data-round-table>
        <caption class="visually-hidden">Per-round vote counts</caption>
        <thead>
          <tr>
            <th scope="col" class="round-table-head">OPTION</th>
            {ranked.rounds.map((round) => (
              <th scope="col" class="round-table-head">
                ROUND {round.roundNumber}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {allOptionIds.map((optionId) => {
            const label =
              ranked.rounds[0]?.counts.find((c) => c.optionId === optionId)
                ?.label ?? "—";
            const isWinnerOption =
              ranked.resolved && ranked.winnerId === optionId;
            const isTiedOption =
              !ranked.resolved &&
              ranked.tiedOptionIds.includes(optionId);
            return (
              <tr
                class:list={[
                  "round-table-row",
                  isTiedOption && "is-tied-option",
                ]}
                data-option-id={optionId}
              >
                <th scope="row" class="round-table-option">
                  {label}
                </th>
                {ranked.rounds.map((round, ri) => {
                  const count = countForOption(optionId, ri);
                  const eliminatedBefore = isEliminatedBefore(optionId, ri);
                  const eliminatedThisRound =
                    round.eliminated?.optionIds.includes(optionId) ?? false;
                  const isWinnerCell =
                    isWinnerOption && ri === ranked.rounds.length - 1;
                  const faint = eliminatedBefore || eliminatedThisRound;
                  return (
                    <td
                      class:list={[
                        "round-table-cell",
                        faint && "is-faint",
                        isWinnerCell && "is-winner-cell",
                      ]}
                    >
                      {count !== null ? String(count) : "—"}
                    </td>
                  );
                })}
              </tr>
            );
          })}
          {ranked.rounds.some((r) => r.exhaustedCount > 0) && (
            <tr class="round-table-row round-table-exhausted">
              <th scope="row" class="round-table-option">EXHAUSTED</th>
              {ranked.rounds.map((round) => (
                <td class="round-table-cell">
                  {round.exhaustedCount > 0
                    ? String(round.exhaustedCount)
                    : "—"}
                </td>
              ))}
            </tr>
          )}
        </tbody>
      </table>
    </div>
  )}
  {!ranked.empty &&
    ranked.rounds.map((round) => {
      if (!round.eliminated) return null;
      return (
        <p class="round-table-elimination" data-elimination-round={round.roundNumber}>
          {eliminationStatement(round.eliminated)}
        </p>
      );
    })}
  {status === "closed" && canonicalReference && (
    <a
      class="manifest-link"
      href={`/${encodeURIComponent(canonicalReference)}/manifest`}
    >
      BALLOT MANIFEST
    </a>
  )}
</section>

<style>
  .ranked-results {
    display: grid;
    gap: var(--space-4);
  }

  .ranked-outcome {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-title-size);
    line-height: var(--type-title-lh);
    color: var(--color-ink);
  }

  .ranked-meta {
    margin: 0;
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-lg-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .ranked-standing {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .ranked-standing-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .ranked-standing-label {
    color: var(--color-ink);
  }

  .ranked-standing-row.is-winner .ranked-standing-label {
    font-weight: 600;
  }

  .ranked-standing-count {
    font-family: var(--font-machine);
    color: var(--color-dim);
  }

  .ranked-standing-mark {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-solar);
  }

  .ranked-standing-row.is-tied .ranked-standing-mark {
    color: var(--color-dim);
  }

  .ranked-your-ballot {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }

  .ranked-your-ballot-label {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .ranked-your-ballot-options {
    font-family: var(--font-machine);
    font-size: var(--type-data-size);
    font-weight: 700;
    line-height: var(--type-data-lh);
    color: var(--color-ink);
  }

  .ranked-unresolved-copy {
    margin: 0;
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-lh);
    color: var(--color-ink);
  }

  .round-table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .round-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 320px;
  }

  .round-table-head {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    font-weight: 400;
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-dim);
    padding: var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
    white-space: nowrap;
  }

  .round-table-option {
    font-family: var(--font-machine);
    font-size: var(--type-data-size);
    font-weight: 700;
    line-height: var(--type-data-lh);
    color: var(--color-ink);
    padding: var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
    white-space: nowrap;
  }

  .round-table-cell {
    font-family: var(--font-machine);
    font-size: var(--type-data-size);
    font-weight: 700;
    line-height: var(--type-data-lh);
    color: var(--color-ink);
    padding: var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    text-align: right;
    white-space: nowrap;
  }

  .round-table-cell.is-faint {
    color: var(--color-faint);
    text-decoration: line-through;
  }

  .round-table-cell.is-winner-cell {
    color: var(--color-solar-ink);
  }

  .round-table-row.is-tied-option .round-table-option {
    border-left: 2px solid var(--color-entropy);
  }

  .round-table-exhausted .round-table-option,
  .round-table-exhausted .round-table-cell {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    font-weight: 400;
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .round-table-elimination {
    margin: 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-ink);
  }

  .manifest-link {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-entropy);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .manifest-link:focus-visible {
    outline: 2px solid var(--color-entropy);
    outline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
