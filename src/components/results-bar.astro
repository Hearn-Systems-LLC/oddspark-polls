---
/**
 * Static token-bound results bar (Story 1.1 skeleton; Story 1.8 live data).
 * 34px mobile / 38px desktop on a 1px baseline rule, entropy wash fill with
 * a 2px leading edge, label left, value cluster right (percentage in data
 * typography, raw count in caption typography). The sole leader swaps to
 * solar wash/edge and prefixes its value cluster with the decorative ◆;
 * the marker sits before the value, never the label, and is aria-hidden.
 * Motion (Story 1.10): width and leader-color transitions sit behind the
 * is-motion-armed class script adds to the tally root after first paint,
 * so the server-rendered state never animates; the spark fires via a
 * short-lived is-spark class on the fill. Both snap under reduced motion.
 * The data-percent/data-count/data-pie-share attributes are the pie view's
 * one data source (Story 1.10) — server-rendered here, kept current by the
 * poller. The unrounded share is server-owned geometry; percent is display.
 */
import { barAccessibleName, barWidthPercent } from "./results-bar";
import type { PollOptionId } from "../shared/domain/index";

interface Props {
  label: string;
  percent: number;
  /** Server-computed, unrounded Voter share used only for PIE geometry. */
  pieShare?: number;
  count: number;
  /** Stable live-reconciliation key. Loading/demo bars intentionally omit it. */
  optionId?: PollOptionId;
  leader?: boolean;
  /** Cold-load skeleton row: label on its baseline at zero width, named as
   * loading — never announced as a real "0 percent, 0 votes" result. */
  loading?: boolean;
  /** Marks the post-vote confirmation's own bar(s) (Story 1.10) — the
   * attribute exists only on that render, never gold, never a second ◆. */
  yourOption?: boolean;
  class?: string;
}

const {
  label,
  percent,
  pieShare,
  count,
  optionId,
  leader = false,
  loading = false,
  yourOption = false,
  class: className = "",
} = Astro.props;

const normalizedPercent = barWidthPercent(percent);
const width = loading ? 0 : normalizedPercent;
const accessibleName = loading
  ? `${label}, loading`
  : barAccessibleName(label, normalizedPercent, count, leader);
---

<div
  class:list={[
    "results-bar",
    leader && !loading && "is-leader",
    (loading || count === 0) && "is-zero",
    className,
  ]}
  role="img"
  aria-label={accessibleName}
  data-option-id={optionId}
  data-percent={normalizedPercent}
  data-count={count}
  data-pie-share={pieShare}
  data-your-option={yourOption ? "true" : undefined}
>
  <div class="results-bar-track" style={`--bar-width: ${width}%`}>
    <div class="results-bar-fill"></div>
    <div class="results-bar-content">
      <span class="results-bar-label">{label}</span>
      {
        !loading && (
          <span class="results-bar-value">
            <span
              class="results-bar-leader-mark"
              aria-hidden="true"
              hidden={!leader}
            >◆</span>
            <span class="results-bar-pct">{normalizedPercent}%</span>
            <span class="results-bar-count"> · {count}</span>
          </span>
        )
      }
    </div>
  </div>
</div>

<style>
  .results-bar {
    border-bottom: var(--space-hairline) solid var(--color-rule);
  }

  .results-bar-track {
    position: relative;
    height: var(--results-bar-height);
    overflow: hidden;
    background: var(--color-panel);
  }

  .results-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--bar-width);
    background: var(--results-bar-fill);
    border-right: var(--results-bar-leading-edge-width) solid var(--results-bar-edge);
  }

  /* Zero width keeps the baseline and label but suppresses the 2px edge. */
  .results-bar.is-zero .results-bar-fill {
    border-right: none;
  }

  .results-bar.is-leader .results-bar-fill {
    background: var(--results-bar-fill-leader);
    border-right-color: var(--results-bar-edge-leader);
  }

  /* Motion stays inert until script arms the tally root after first paint,
     and never touches the cold-load skeleton — only the final bar group. */
  :global(.results-tally.is-motion-armed [data-tally-final]) .results-bar-fill {
    transition:
      width var(--motion-bar-transition) var(--motion-ease),
      background-color var(--motion-leader-crossfade) var(--motion-ease),
      border-right-color var(--motion-leader-crossfade) var(--motion-ease);
  }

  /* The spark: the leading edge flashes to the spark width and settles
     back, fired by a short-lived is-spark class on the fill. ease-in-out
     suits the symmetric 2→4→2 loop; --motion-ease is a settle curve. */
  :global(.results-tally [data-tally-final]) .results-bar-fill.is-spark {
    animation: results-bar-spark var(--motion-spark) ease-in-out;
  }

  @keyframes results-bar-spark {
    0%,
    100% {
      border-right-width: var(--results-bar-leading-edge-width);
    }
    50% {
      border-right-width: var(--results-bar-leading-edge-width-spark);
    }
  }

  .results-bar-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    height: var(--results-bar-height);
    padding-inline: var(--space-3);
  }

  .results-bar-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .results-bar-value {
    flex: 0 0 auto;
    font-family: var(--font-machine);
    color: var(--color-text);
    white-space: nowrap;
    /* Courier Prime digits are already fixed-width; this protects the
       fallback stack so a ticking count never reflows. */
    font-variant-numeric: tabular-nums;
  }

  .results-bar-leader-mark {
    color: var(--results-bar-leader-marker-color);
    margin-right: var(--space-2);
  }

  .results-bar-leader-mark[hidden] {
    display: none;
  }

  .results-bar-pct {
    display: inline-block;
    inline-size: 4ch;
    font-size: var(--type-data-size);
    font-weight: 700;
    line-height: var(--type-data-lh);
    text-align: right;
  }

  .results-bar-count {
    /* Common totals reserve three digits; the count-up slot grows this
       monotonically to its next target before ticking across any boundary. */
    display: inline-block;
    min-inline-size: 6ch;
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
    text-align: right;
  }

  @media (min-width: 1024px) {
    .results-bar-track,
    .results-bar-content {
      height: var(--results-bar-height-desktop);
    }
  }

  /* Reduced motion never reduces information: widths and colors still
     change, they just land on the frame. The selectors must tie the armed
     and spark rules' specificity (a media query adds none) and beat them
     on source order, or the armed transition survives the override. */
  @media (prefers-reduced-motion: reduce) {
    .results-bar-fill,
    :global(.results-tally.is-motion-armed [data-tally-final]) .results-bar-fill,
    :global(.results-tally [data-tally-final]) .results-bar-fill.is-spark {
      transition: none;
      animation: none;
    }
  }
</style>
