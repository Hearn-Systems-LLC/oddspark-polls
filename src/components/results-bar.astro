---
/**
 * Static token-bound results bar (Story 1.1 skeleton; Story 1.8 live data).
 * 34px mobile / 38px desktop on a 1px baseline rule, entropy wash fill with
 * a 2px leading edge, label left, value cluster right (percentage in data
 * typography, raw count in caption typography). The sole leader swaps to
 * solar wash/edge and prefixes its value cluster with the decorative ◆;
 * the marker sits before the value, never the label, and is aria-hidden.
 * Initial/final width carries no CSS transition in this story.
 */
import { barAccessibleName, barWidthPercent } from "./results-bar";
import type { PollOptionId } from "../shared/domain/index";

interface Props {
  label: string;
  percent: number;
  count: number;
  /** Stable live-reconciliation key. Loading/demo bars intentionally omit it. */
  optionId?: PollOptionId;
  leader?: boolean;
  /** Cold-load skeleton row: label on its baseline at zero width, named as
   * loading — never announced as a real "0 percent, 0 votes" result. */
  loading?: boolean;
  class?: string;
}

const {
  label,
  percent,
  count,
  optionId,
  leader = false,
  loading = false,
  class: className = "",
} = Astro.props;

const normalizedPercent = barWidthPercent(percent);
const width = loading ? 0 : normalizedPercent;
const accessibleName = loading
  ? `${label}, loading`
  : barAccessibleName(label, normalizedPercent, count, leader);
---

<div
  class:list={[
    "results-bar",
    leader && !loading && "is-leader",
    width === 0 && "is-zero",
    className,
  ]}
  role="img"
  aria-label={accessibleName}
  data-option-id={optionId}
>
  <div class="results-bar-track" style={`--bar-width: ${width}%`}>
    <div class="results-bar-fill"></div>
    <div class="results-bar-content">
      <span class="results-bar-label">{label}</span>
      {
        !loading && (
          <span class="results-bar-value">
            <span
              class="results-bar-leader-mark"
              aria-hidden="true"
              hidden={!leader}
            >◆</span>
            <span class="results-bar-pct">{normalizedPercent}%</span>
            <span class="results-bar-count"> · {count}</span>
          </span>
        )
      }
    </div>
  </div>
</div>

<style>
  .results-bar {
    border-bottom: var(--space-hairline) solid var(--color-rule);
  }

  .results-bar-track {
    position: relative;
    height: var(--results-bar-height);
    overflow: hidden;
    background: var(--color-panel);
  }

  .results-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--bar-width);
    background: var(--results-bar-fill);
    border-right: var(--results-bar-leading-edge-width) solid var(--results-bar-edge);
  }

  /* Zero width keeps the baseline and label but suppresses the 2px edge. */
  .results-bar.is-zero .results-bar-fill {
    border-right: none;
  }

  .results-bar.is-leader .results-bar-fill {
    background: var(--results-bar-fill-leader);
    border-right-color: var(--results-bar-edge-leader);
  }

  .results-bar-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    height: var(--results-bar-height);
    padding-inline: var(--space-3);
  }

  .results-bar-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .results-bar-value {
    flex: 0 0 auto;
    font-family: var(--font-machine);
    color: var(--color-text);
    white-space: nowrap;
  }

  .results-bar-leader-mark {
    color: var(--results-bar-leader-marker-color);
    margin-right: var(--space-2);
  }

  .results-bar-leader-mark[hidden] {
    display: none;
  }

  .results-bar-pct {
    font-size: var(--type-data-size);
    font-weight: 700;
    line-height: var(--type-data-lh);
  }

  .results-bar-count {
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  @media (min-width: 1024px) {
    .results-bar-track,
    .results-bar-content {
      height: var(--results-bar-height-desktop);
    }
  }
</style>
