---
/**
 * The one static Tally renderer (Story 1.8) — reused by the direct Results
 * route and the post-vote surface. Owns creator-authored option order, the
 * `N VOTERS · M SELECTIONS` multi-select summary, the optional `TIED` line,
 * the all-zero empty copy, the single-select-only `BARS · PIE` chart-form
 * toggle (Story 1.10, server-rendered hidden and revealed by its script),
 * the bar group, and the optional text-only `YOUR BALLOT` block. Gold
 * belongs to the unique leader alone: a tied or
 * empty Tally carries none, and a voter's own ballot never adds a second
 * gold or ◆.
 *
 * The `loading` variant is the fail-open cold-load state (UX-DR19): the
 * server renders the authorized final Tally as the no-JS floor, plus a
 * hidden skeleton of labelled zero-width bars at the real option count —
 * no shimmer, no animation. When JS runs, the inline enhancer presents the
 * skeleton immediately, lets it paint, then reveals the already-rendered
 * final Tally with no transition. If the enhancer fails, the final Tally
 * stays available. That cold-load transition performs no fetch and embeds no
 * result JSON; Story 1.9's separate optional live endpoint starts only after
 * the complete server-rendered Tally exists.
 */
import { RESULTS_COPY, type ResultsTallyView } from "../modules/results/index";
import type {
  PollOptionId,
  PollSecurityToggles,
  PollStatus,
} from "../shared/domain/index";
import ChartFormToggle from "./chart-form-toggle.astro";
import LiveIndicator from "./live-indicator.astro";
import { formatVoteTotal } from "./live-indicator";
import ResultsBar from "./results-bar.astro";
import TrustBadge from "./trust-badge.astro";

interface Props {
  tally: ResultsTallyView;
  /** Effective request-time state; entitled surfaces render LIVE or CLOSED
   * correctly even without JavaScript. */
  status: PollStatus;
  /** The viewer's own selected labels in stored option order — text only,
   * never a second gold. Omit entirely when no claim resolved. */
  yourBallotLabels?: string[];
  /** The viewer's own selected option IDs (Story 1.10) — marks their bar(s)
   * with data-your-option on the counted confirmation render only; absent
   * for every other surface and never on hidden branches. */
  yourBallotOptionIds?: PollOptionId[];
  /** Persisted toggle truth for the trust badge (Story 2.4, UX-DR7) — the
   * badge explains the visible numbers, so it renders after the bars and
   * only on surfaces where the Tally is visible. Omit on hidden branches. */
  toggles?: PollSecurityToggles;
  /** Present the cold-load skeleton first, resolving on the first frame. */
  loading?: boolean;
  /** Exact private/no-store endpoint for the open progressive enhancer. */
  liveEndpoint?: string;
  /** Server render time used until the first successful refresh. */
  initialRenderAtMs?: number;
  class?: string;
}

const {
  tally,
  status,
  yourBallotLabels = [],
  yourBallotOptionIds = [],
  toggles,
  loading = false,
  liveEndpoint,
  initialRenderAtMs = Date.now(),
  class: className = "",
} = Astro.props;
---

<div
  class:list={["results-tally", className]}
  data-results-tally
  data-loading={loading ? "true" : "false"}
  data-live-endpoint={liveEndpoint}
  data-live-initial-render-at={initialRenderAtMs}
  data-live-status={status}
>
  {
    yourBallotLabels.length > 0 && (
      <div class="results-tally-ballot" data-your-ballot>
        <span class="results-tally-ballot-label">{RESULTS_COPY.yourBallot}</span>
        <span class="results-tally-ballot-value">
          {yourBallotLabels.join(" · ")}
        </span>
      </div>
    )
  }
  <div class="results-tally-final-region" data-tally-final-region>
    {
      tally.multiSelectEnabled && (
        <p class="results-tally-summary" data-live-summary>
          {tally.voterCount} VOTERS · {tally.selectionCount} SELECTIONS
        </p>
      )
    }
    <p class="results-tally-tied" data-live-tied hidden={!tally.tied}>
      {RESULTS_COPY.tied}
    </p>
    <p class="results-tally-empty" data-live-empty hidden={!tally.empty}>
      {RESULTS_COPY.empty}
    </p>
    <p
      class="results-tally-live"
      data-results-live-region
      aria-live="polite"
    >
      <span data-live-status-content>
        <LiveIndicator status={status}>
          {
            /* The visible total ticks inside an aria-hidden span (Story 1.10
               count-up) while the announced copy is written once per
               reconcile with the final value — a tween must never spam the
               one polite region. */
          }
          <span data-live-total-visual aria-hidden="true">{formatVoteTotal(tally.voterCount)}</span>
          <span class="visually-hidden" data-live-total>{formatVoteTotal(tally.voterCount)}</span>
          <span aria-hidden="true"> · </span>
        </LiveIndicator>
      </span>
      <span class="results-tally-stale" data-live-stale hidden>
        Not receiving updates. The counts shown are from <span
          data-live-stale-time
        ></span>.
      </span>
      <span class="visually-hidden" data-live-announcement></span>
    </p>
    {
      /* Multi-select Polls are bars-only (ratified, Story 1.10): per-option
         shares of VOTERS sum past 100% and cannot form an honest pie, so
         the toggle is not emitted at all. Sits immediately before the bar
         group — above it in reading order and in the desktop grid. */
    }
    {!tally.multiSelectEnabled && <ChartFormToggle />}
    <div class="results-tally-bars" data-tally-final>
      {
        tally.options.map((option) => (
          <ResultsBar
            optionId={option.id}
            label={option.label}
            percent={option.percent}
            pieShare={option.pieShare}
            count={option.count}
            leader={option.leading}
            yourOption={yourBallotOptionIds.includes(option.id)}
          />
        ))
      }
    </div>
  </div>
  {
    /* Story 2.4: bars → badge (key-tally.html). Inside [data-results-tally]
       is safe — the live reconciler mutates only [data-live-*] and
       [data-tally-final] nodes, so the badge survives every refresh. The
       badge renders nothing at all when no Toggle is enforced (SM-C1). */
    toggles && <TrustBadge toggles={toggles} class="results-tally-badge" />
  }
  {
    loading && (
      <div
        class="results-tally-bars"
        data-tally-skeleton
        aria-busy="true"
        hidden
      >
        {tally.options.map((option) => (
          <ResultsBar label={option.label} percent={0} count={0} loading />
        ))}
      </div>
    )
  }
  {
    loading && (
      <script is:inline>
        (function () {
          var script = document.currentScript;
          var root = script && script.parentElement;
          if (!root) {
            return;
          }
          var skeleton = root.querySelector("[data-tally-skeleton]");
          var finalRegion = root.querySelector("[data-tally-final-region]");
          if (!skeleton || !finalRegion) {
            return;
          }
          var finish = function () {
            finalRegion.hidden = false;
            skeleton.hidden = true;
            skeleton.removeAttribute("aria-busy");
            root.setAttribute("data-loading", "false");
          };
          try {
            skeleton.hidden = false;
            finalRegion.hidden = true;
            requestAnimationFrame(function () {
              try {
                // A second frame guarantees the skeleton received a paint.
                requestAnimationFrame(finish);
              } catch (error) {
                finish();
              }
            });
          } catch (error) {
            // Fail open: the authorized final Tally must never stay hidden.
            finish();
          }
        })();
      </script>
    )
  }
</div>

<style>
  .results-tally {
    display: block;
  }

  .results-tally-ballot {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
  }

  .results-tally-ballot-label {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .results-tally-ballot-value {
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  /* Dissolve the wrapper so the existing post-vote desktop grid continues
     to place its metadata and bars independently. */
  .results-tally-final-region {
    display: contents;
  }

  .results-tally-summary,
  .results-tally-tied {
    margin: 0 0 var(--space-3);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-lg-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .results-tally-empty {
    margin: 0 0 var(--space-3);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    color: var(--color-text);
  }

  .results-tally-live {
    margin: 0 0 var(--space-3);
  }

  .results-tally-stale {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-lg-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .results-tally-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Badge follows the bars with a 24px rise (key-tally.html); the post-vote
     surface overrides to 32px from the page scope. */
  .results-tally-badge {
    margin-top: var(--space-6);
  }

  /* `hidden` loses to author display rules without an explicit guard. */
  .results-tally-final-region[hidden],
  .results-tally-bars[hidden],
  .results-tally-tied[hidden],
  .results-tally-empty[hidden],
  .results-tally-stale[hidden],
  [data-live-status-content][hidden] {
    display: none;
  }
</style>
