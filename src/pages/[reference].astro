---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/base-layout.astro";
import PollVotingSurface from "../components/poll-voting-surface.astro";
import {
  deliverPollVotingSurface,
  serializeDeliveryCookieEffect,
} from "../lib/poll-delivery";
import { effectivePollStatus } from "../shared/domain/index";
import {
  VOTER_COOKIE_NAME,
} from "../adapters/digest/index";
import { VOTE_FLASH_COOKIE_NAME } from "../lib/poll-delivery";
import { MEETING_REVISION_COOKIE_NAME } from "../lib/poll-delivery";

const reference = Astro.params.reference ?? "";
const delivery = await deliverPollVotingSurface({
  reference,
  request: Astro.request,
  env,
  principalUserId: Astro.locals.principal?.userId ?? null,
  requestContext: Astro.locals.requestContext ?? null,
  voterCookie: Astro.cookies.get(VOTER_COOKIE_NAME)?.value ?? null,
  flashCookie: Astro.cookies.get(VOTE_FLASH_COOKIE_NAME)?.value ?? null,
  revisionCookie: Astro.cookies.get(MEETING_REVISION_COOKIE_NAME)?.value ?? null,
  formAction: `/${reference}`,
  successRedirect: `/${reference}`,
  includeEditableTally: false,
  allowCanonicalCaseRedirect: true,
  operationalUnavailable: false,
});

for (const [name, value] of Object.entries(delivery.headers)) {
  Astro.response.headers.set(name, value);
}
if (delivery.response) {
  const responseHeaders = new Headers(delivery.response.headers);
  delivery.cookies.forEach((effect) =>
    responseHeaders.append("set-cookie", serializeDeliveryCookieEffect(effect)),
  );
  return new Response(delivery.response.body, {
    status: delivery.response.status,
    headers: responseHeaders,
  });
}
delivery.cookies.forEach((effect) =>
  Astro.response.headers.append("set-cookie", serializeDeliveryCookieEffect(effect)),
);
Astro.response.status = delivery.status;

const state = delivery.state;
const poll = state?.poll ?? null;
const title = !poll
  ? "Not found — Oddspark Polls"
  : state?.outcome
    ? `${state.outcome.titlePrefix} — ${poll.question}`
    : `${poll.question} — Oddspark Polls`;
const canonicalUrl = poll
  ? `${Astro.url.origin}/${encodeURIComponent(poll.canonicalReference)}`
  : undefined;
const robots =
  !poll ||
  poll.discoveryState !== "listed" ||
  effectivePollStatus(poll, Date.now()) !== "open"
    ? "noindex"
    : undefined;
if (robots) Astro.response.headers.set("x-robots-tag", robots);
---

<BaseLayout title={title} canonicalUrl={canonicalUrl} robots={robots}>
  <main>
    {
      state ? (
        <PollVotingSurface
          delivery={state}
          formAction={`/${reference}`}
          canonicalUrl={`${Astro.url.origin}/${state.poll.canonicalReference}`}
          liveEndpoint={`/${encodeURIComponent(reference)}/results/live`}
          turnstileSiteKey={env.TURNSTILE_SITE_KEY}
        />
      ) : (
        <h1 class="not-found" tabindex="-1" autofocus>This Poll doesn't exist.</h1>
      )
    }
  </main>
</BaseLayout>

<style>
  .not-found {
    width: min(100%, var(--space-measure));
    margin: var(--space-8) auto 0;
    padding-inline: var(--space-margin-mobile);
    color: var(--color-dim);
    font-size: var(--type-caption-size);
    font-weight: 400;
    line-height: var(--type-caption-lh);
  }
</style>
