---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/base-layout.astro";
import { createPollPersistence } from "../adapters/d1/index";
import { isReservedSlug } from "../modules/polls/reserved-slugs";

// Root-path poll page (AD-13): the canonical reference resolves here.
// Story 1.3 delivers the reachable, open Poll — question and options
// server-rendered with zero client framework payload. The vote form and
// its transaction arrive with Story 1.5.

const reference = Astro.params.reference ?? "";

// Only GET/HEAD are meaningful on the public poll page.
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response("Method not allowed.", {
    status: 405,
    headers: { allow: "GET, HEAD", "cache-control": "no-store" },
  });
}

// Routing and slug validation share one reserved-slug registry (AD-13).
const poll = isReservedSlug(reference)
  ? null
  : await createPollPersistence(env.DB).findPollByReference(reference);

if (!poll) {
  Astro.response.status = 404;
}

const title = poll
  ? `${poll.question} — Oddspark Polls`
  : "Not found — Oddspark Polls";
---

<BaseLayout title={title}>
  <main class="poll-shell">
    {
      poll ? (
        <>
          <h1 class="poll-question">{poll.question}</h1>
          {poll.description && <p class="poll-description">{poll.description}</p>}
          <ul class="poll-options" aria-label="Options">
            {poll.options.map((option) => (
              <li class="poll-option-row">
                <span class="poll-option-marker" aria-hidden="true">·</span>
                <span>{option.label}</span>
              </li>
            ))}
          </ul>
          <p class="helper-note">Voting opens in a coming release.</p>
        </>
      ) : (
        <h1 class="not-found" tabindex="-1" autofocus>This Poll doesn't exist.</h1>
      )
    }
  </main>
</BaseLayout>

<style>
  .poll-shell {
    width: min(100%, var(--space-measure));
    margin-inline: auto;
    padding: var(--space-8) var(--space-margin-mobile) var(--space-section-gap);
  }

  .poll-question {
    margin: 0 0 var(--space-4);
    font-family: var(--font-human);
    font-size: var(--type-poll-question-size);
    font-weight: 400;
    line-height: var(--type-poll-question-lh);
  }

  .poll-description {
    margin: 0 0 var(--space-6);
    color: var(--color-dim);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    white-space: pre-wrap;
  }

  .poll-options {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .poll-option-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .poll-option-marker {
    color: var(--color-faint);
  }

  .helper-note,
  .not-found {
    margin: var(--space-4) 0 0;
    color: var(--color-dim);
    font-size: var(--type-caption-size);
    font-weight: 400;
    line-height: var(--type-caption-lh);
  }

  @media (min-width: 640px) {
    .poll-shell {
      padding-inline: var(--space-margin-desktop);
    }
  }
</style>
