---
import { env } from "cloudflare:workers";
import { z } from "zod";
import ButtonPrimary from "../../components/button-primary.astro";
import Input from "../../components/input.astro";
import PollOption from "../../components/poll-option.astro";
import PollDefinitionFields from "../../components/poll-definition-fields.astro";
import SecurityToggle from "../../components/security-toggle.astro";
import BaseLayout from "../../layouts/base-layout.astro";
import { createPollPersistence } from "../../adapters/d1/index";
import {
  createPoll,
  generatePollReference,
  isUuidShape,
  CREATE_POLL_COPY,
  RECENTLY_CREATED_WINDOW_MS,
  SECURITY_TOGGLE_META,
  type CreatePollDraft,
  type PollPersistenceRows,
} from "../../modules/polls/index";
import {
  POLL_CAPS,
  RENDER_OPTION_CEILING,
} from "../../modules/polls/caps";
import { LISTING_CHOICES } from "../../modules/discovery/index";
import {
  SECURITY_TOGGLES,
  type PollId,
  type PollOptionId,
  type UserId,
} from "../../shared/domain/index";
import {
  validateImageUpload,
  IMAGE_UPLOAD_CAPS,
  IMAGE_UPLOAD_COPY,
} from "../../modules/polls/image-upload";
import { imageStrategy, IMAGE_DEFINITION_COPY } from "../../modules/polls/types/image";

// Creator responses are never cached (AD-21).
Astro.response.headers.set("cache-control", "private, no-store");

// The middleware chain guards origin and auth but not method: only GET/HEAD
// (render) and POST (handle) are meaningful here.
if (
  Astro.request.method !== "GET" &&
  Astro.request.method !== "HEAD" &&
  Astro.request.method !== "POST"
) {
  return new Response("Method not allowed.", {
    status: 405,
    headers: { allow: "GET, HEAD, POST", "cache-control": "private, no-store" },
  });
}

const requestContext = Astro.locals.requestContext;
const principal = requestContext?.principal ?? null;
if (!principal) {
  // The creator guard middleware already redirects; this is defense in
  // depth. Built manually so the no-store header rides along — an early
  // Astro.redirect return doesn't compose Astro.response.headers.
  return new Response(null, {
    status: 303,
    headers: {
      location: `/sign-in?return=${encodeURIComponent("/creator/new")}`,
      "cache-control": "private, no-store",
    },
  });
}
const csrfToken = requestContext?.csrfToken?.value ?? "";

const VISIBILITY_CHOICES = [
  { value: "live", label: "LIVE", description: "anyone with the link watches the count move" },
  { value: "after_close", label: "AFTER CLOSE", description: "Voters see a confirmation until the Poll closes" },
  { value: "creator_only", label: "CREATOR-ONLY", description: "only you ever see the Tally" },
] as const;

const INITIAL_OPTION_ROWS = 4;

const formSchema = z.object({
  pollType: z.string().default(""),
  question: z.string().default(""),
  description: z.string().default(""),
  options: z.array(z.string()).default([]),
  slots: z.array(z.object({
    date: z.string().default(""),
    start: z.string().default(""),
    end: z.string().default(""),
  })).default([]),
  visibility: z.string().default(""),
  listing: z.string().default(""),
  deadline: z.string().default(""),
  timezone: z.string().default(""),
  customLink: z.string().default(""),
  multiSelect: z.string().default("false"),
  minSelections: z.string().default(""),
  maxSelections: z.string().default(""),
  commentsEnabled: z.enum(["true", "false"]).default("false"),
  sessionChecks: z.string().default(""),
  ipChecks: z.string().default(""),
  voterCodes: z.string().default(""),
  captcha: z.string().default(""),
  vpnBlocking: z.string().default(""),
  intent: z.string().default(""),
  pollId: z.string().default(""),
});

// No-JS duplicate-POST dedupe (D4): every render mints a poll UUID carried
// in a hidden field; a retried publish with the same ID collides on the poll
// PRIMARY KEY instead of minting a second Poll.
let formPollId = crypto.randomUUID() as PollId;

// Fresh GET: Session Checks on, every other Toggle off (FR-15). Defaults live
// in the render only — absent POST checkboxes still mean off.
let values: CreatePollDraft = {
  pollType: "multiple_choice",
  question: "",
  description: "",
  options: Array.from({ length: INITIAL_OPTION_ROWS }, () => ""),
  slots: Array.from({ length: 2 }, () => ({ date: "", start: "", end: "" })),
  resultVisibility: "live",
  discoveryState: "unlisted",
  deadlineLocal: "",
  timeZone: "",
  customLink: "",
  multiSelect: "false",
  minSelections: "",
  maxSelections: "",
  commentsEnabled: "false",
  sessionChecks: "true",
  ipChecks: "false",
  voterCodes: "false",
  captcha: "false",
  vpnBlocking: "false",
  idempotencyId: formPollId,
};
let fieldErrors: Record<string, string> = {};
let formError: string | null = null;
// Informational guidance for a declined no-JS ADD OPTION — not a validation
// failure, so it renders as a note on a 200, not as an error on a 422.
let optionNote: string | null = null;
let slotNote: string | null = null;

// Image Poll media state (Story 6.1). Tracks successfully uploaded temp keys
// for re-render preservation and alt text / caption per option.
type TempMediaEntry = {
  mediaId: string;
  r2Key: string;
  contentType: string;
  sizeBytes: number;
  altText: string;
  caption: string;
};
let tempMedia: TempMediaEntry[] = [];

if (Astro.request.method === "POST") {
  let parsed: z.infer<typeof formSchema>;
  // Image Poll file entries extracted before text coercion eats them. The
  // index is the raw option-row index parsed from the field name.
  const imageFiles: { index: number; file: File }[] = [];
  // Preserved temp-media refs from hidden inputs on a 422 re-render.
  const preservedRefs: { index: number; mediaId: string }[] = [];
  try {
    const formData = await Astro.request.formData();
    // Extract File parts from their own per-index fields — never mixed with
    // the option label strings under name="option".
    for (const [key, value] of formData.entries()) {
      const fileMatch = key.match(/^media_file_(\d+)$/);
      if (fileMatch && value instanceof File && value.size > 0) {
        imageFiles.push({ index: parseInt(fileMatch[1]!, 10), file: value });
      }
    }
    // Extract preserved temp-media refs (hidden inputs from 422 re-render).
    const mediaRefEntries = formData.getAll("media_ref");
    for (const entry of mediaRefEntries) {
      if (typeof entry === "string" && entry.length > 0) {
        // Format: "{index}:{mediaId}"
        const colonIdx = entry.indexOf(":");
        if (colonIdx > 0) {
          const idx = parseInt(entry.slice(0, colonIdx), 10);
          const mediaId = entry.slice(colonIdx + 1);
          if (!Number.isNaN(idx) && isUuidShape(mediaId)) {
            preservedRefs.push({ index: idx, mediaId });
          }
        }
      }
    }
    // Extract alt text and caption per option index.
    const altTexts: Record<number, string> = {};
    const captions: Record<number, string> = {};
    const slotParts: Record<number, { date: string; start: string; end: string }> = {};
    for (const [key, value] of formData.entries()) {
      if (typeof value !== "string") continue;
      const altMatch = key.match(/^media_alt_(\d+)$/);
      if (altMatch) {
        altTexts[parseInt(altMatch[1]!, 10)] = value;
      }
      const capMatch = key.match(/^media_caption_(\d+)$/);
      if (capMatch) {
        captions[parseInt(capMatch[1]!, 10)] = value;
      }
      const slotMatch = key.match(/^slot_(date|start|end)_(\d+)$/);
      if (slotMatch) {
        const index = parseInt(slotMatch[2]!, 10);
        const row = slotParts[index] ?? { date: "", start: "", end: "" };
        row[slotMatch[1] as "date" | "start" | "end"] = value;
        slotParts[index] = row;
      }
    }

    // Multipart bodies can carry File parts in any field — keep strings
    // only so a File can never throw the parse or persist as "[object File]".
    const text = (entry: FormDataEntryValue | null): string =>
      typeof entry === "string" ? entry : "";
    parsed = formSchema.parse({
      pollType: text(formData.get("pollType")) || "multiple_choice",
      question: text(formData.get("question")),
      description: text(formData.get("description")),
      options: formData
        .getAll("option")
        .filter((entry): entry is string => typeof entry === "string"),
      slots: Object.keys(slotParts)
        .map(Number)
        .sort((a, b) => a - b)
        .map((index) => slotParts[index]!),
      visibility: text(formData.get("visibility")),
      listing: text(formData.get("listing")),
      deadline: text(formData.get("deadline")),
      timezone: text(formData.get("timezone")),
      customLink: text(formData.get("customLink")),
      multiSelect: text(formData.get("multiSelect")) || "false",
      minSelections: text(formData.get("minSelections")),
      maxSelections: text(formData.get("maxSelections")),
      commentsEnabled: text(formData.get("commentsEnabled")) || "false",
      sessionChecks: text(formData.get("sessionChecks")),
      ipChecks: text(formData.get("ipChecks")),
      voterCodes: text(formData.get("voterCodes")),
      captcha: text(formData.get("captcha")),
      vpnBlocking: text(formData.get("vpnBlocking")),
      intent: text(formData.get("intent")),
      pollId: text(formData.get("poll_id")),
    });

    // Attach extracted media metadata to parsed for downstream use.
    (parsed as any)._imageFiles = imageFiles;
    (parsed as any)._preservedRefs = preservedRefs;
    (parsed as any)._altTexts = altTexts;
    (parsed as any)._captions = captions;
  } catch {
    return new Response("Unreadable form submission.", {
      status: 422,
      headers: { "cache-control": "private, no-store" },
    });
  }

  // A republished form keeps its nonce; anything else falls back to fresh.
  if (isUuidShape(parsed.pollId)) {
    formPollId = parsed.pollId as PollId;
  }

  const toggleOn = (raw: string): string =>
    raw === "true" ? "true" : "false";

  values = {
    pollType: parsed.pollType,
    question: parsed.question,
    description: parsed.description,
    options: parsed.options,
    slots: parsed.slots,
    resultVisibility: parsed.visibility,
    discoveryState: parsed.listing,
    deadlineLocal: parsed.deadline,
    timeZone: parsed.timezone,
    customLink: parsed.customLink,
    multiSelect: parsed.multiSelect,
    minSelections: parsed.minSelections,
    maxSelections: parsed.maxSelections,
    commentsEnabled: toggleOn(parsed.commentsEnabled),
    sessionChecks: toggleOn(parsed.sessionChecks),
    ipChecks: toggleOn(parsed.ipChecks),
    voterCodes: toggleOn(parsed.voterCodes),
    captcha: toggleOn(parsed.captcha),
    vpnBlocking: toggleOn(parsed.vpnBlocking),
    idempotencyId: formPollId,
  };

  // Image Poll media handling (Story 6.1 / AC 1, 2, 4).
  const isImagePoll = parsed.pollType === "image";
  const extractedFiles = (parsed as any)._imageFiles as typeof imageFiles;
  const extractedPreservedRefs = (parsed as any)._preservedRefs as typeof preservedRefs;
  const extractedAltTexts = (parsed as any)._altTexts as Record<number, string>;
  const extractedCaptions = (parsed as any)._captions as Record<number, string>;

  // Raw option indexes that still carry a non-blank label. Blank rows are
  // dropped on publish (helper-note contract), so media keyed to a blank row
  // is stale and its temp object is swept (6.3). Indexes never shift between
  // round-trips — rows are only appended or cleared.
  const activeRawIndexes = parsed.options
    .map((label, index) => ({ label, index }))
    .filter(({ label }) => label.trim().length > 0)
    .map(({ index }) => index);
  const activeIndexSet = new Set(activeRawIndexes);
  // Compact (persisted) position → raw option-row index.
  const rawIndexForPosition = new Map<number, number>(
    activeRawIndexes.map((rawIndex, position) => [position, rawIndex]),
  );
  // Render state only ever carries entries for live rows.
  tempMedia = tempMedia.filter((_, index) => activeIndexSet.has(index));

  if (isImagePoll) {
    // Upload processing also runs on the no-JS ADD OPTION round-trip so an
    // in-flight image survives adding a row (AC 4). Publish-only validation
    // (media-missing, alt-text-required) stays below the branch.
    for (const { index, file } of extractedFiles) {
      const validation = await validateImageUpload(file);
      if (!validation.ok) {
        fieldErrors[`media[${index}]`] = validation.error;
        continue;
      }
      const mediaId = crypto.randomUUID();
      const r2Key = `tmp/${formPollId}/${mediaId}`;
      try {
        await env.MEDIA.put(r2Key, file.stream(), {
          httpMetadata: { contentType: validation.contentType },
        });
        tempMedia[index] = {
          mediaId,
          r2Key,
          contentType: validation.contentType,
          sizeBytes: validation.sizeBytes,
          altText: extractedAltTexts[index]?.trim() ?? "",
          caption: extractedCaptions[index]?.trim() ?? "",
        };
      } catch {
        fieldErrors[`media[${index}]`] = IMAGE_UPLOAD_COPY.uploadFailed(file.name || "The image");
      }
    }

    // Restore preserved refs from hidden inputs (previous successful uploads).
    // Batch the R2 head calls so they run in parallel (not N sequential round-trips).
    const refsToRestore = extractedPreservedRefs.filter(
      ({ index }) => !tempMedia[index],
    );
    if (refsToRestore.length > 0) {
      const headResults = await Promise.all(
        refsToRestore.map(async ({ index, mediaId }) => {
          const candidateKey = `tmp/${formPollId}/${mediaId}`;
          try {
            const head = await env.MEDIA.head(candidateKey);
            return { index, mediaId, candidateKey, head, error: null };
          } catch (err) {
            return { index, mediaId, candidateKey, head: null, error: err };
          }
        }),
      );
      for (const result of headResults) {
        if (result.head) {
          tempMedia[result.index] = {
            mediaId: result.mediaId,
            r2Key: result.candidateKey,
            contentType: result.head.httpMetadata?.contentType ?? "application/octet-stream",
            sizeBytes: result.head.size,
            altText: extractedAltTexts[result.index]?.trim() ?? "",
            caption: extractedCaptions[result.index]?.trim() ?? "",
          };
        } else {
          fieldErrors[`media[${result.index}]`] = IMAGE_UPLOAD_COPY.preservedRefLost;
        }
      }
    }

    // Publish-only validation: every live option row needs an image, and
    // every image needs alt text (AC 3). Compact position → raw index so the
    // error lands on the field the Creator actually sees.
    if (parsed.intent !== "add-option") {
      for (const [position, rawIndex] of rawIndexForPosition) {
        const entry = tempMedia[rawIndex];
        if (!entry) {
          if (!fieldErrors[`media[${rawIndex}]`]) {
            fieldErrors[`media[${rawIndex}]`] = IMAGE_DEFINITION_COPY.mediaIdMissing;
          }
        } else {
          if (entry.altText.trim().length === 0) {
            fieldErrors[`media[${rawIndex}].altText`] = IMAGE_DEFINITION_COPY.altTextMissing;
          } else if (entry.altText.trim().length > IMAGE_UPLOAD_CAPS.maxAltTextLength) {
            fieldErrors[`media[${rawIndex}].altText`] = IMAGE_UPLOAD_COPY.altTextTooLong;
          }
          if (entry.caption.trim().length > IMAGE_UPLOAD_CAPS.maxCaptionLength) {
            fieldErrors[`media[${rawIndex}].caption`] = IMAGE_UPLOAD_COPY.captionTooLong;
          }
        }
      }
    }
  }

  if (parsed.intent === "add-slot") {
    values.slots = [...(values.slots ?? []), { date: "", start: "", end: "" }];
    slotNote = "One blank slot added. Complete it when you're ready.";
  } else if (parsed.intent === "add-option") {
    // No-JS ADD OPTION round-trip: one more row, everything preserved,
    // nothing validated yet. The cap counts non-blank rows (blank = removed);
    // a decline is guidance on a 200, not a validation error on a 422.
    const nonBlank = values.options.filter(
      (option) => option.trim().length > 0,
    ).length;
    if (
      nonBlank < POLL_CAPS.maxOptions &&
      values.options.length < RENDER_OPTION_CEILING
    ) {
      values.options = [...values.options, ""];
    } else {
      optionNote =
        nonBlank >= POLL_CAPS.maxOptions
          ? CREATE_POLL_COPY.optionsTooMany
          : CREATE_POLL_COPY.rowsTooMany;
    }
  } else {
    // Any media failure (bad file, missing upload, missing alt text) blocks
    // publication on a 422 with every other field and upload preserved.
    const hasMediaErrors = Object.keys(fieldErrors).some((key) =>
      key.startsWith("media["),
    );
    if (hasMediaErrors) {
      Astro.response.status = 422;
    } else {
      const persistence = createPollPersistence(env.DB);
      const nowMs = Date.now();
      const result = await createPoll(
        {
          persist: async (rows) => {
            // For Image Polls, attach media_object rows to the batch (AD-3).
            // rows.options are the compacted non-blank set, so map position
            // back to the raw row index that owns the temp media entry.
            if (isImagePoll) {
              const mediaRows: NonNullable<PollPersistenceRows["media"]> = [];
              for (let position = 0; position < rows.options.length; position++) {
                const rawIndex = rawIndexForPosition.get(position);
                const entry = rawIndex !== undefined ? tempMedia[rawIndex] : undefined;
                if (!entry) continue;
                mediaRows.push({
                  id: entry.mediaId,
                  pollId: rows.poll.id,
                  optionId: rows.options[position]!.id,
                  r2Key: entry.r2Key,
                  contentType: entry.contentType,
                  sizeBytes: entry.sizeBytes,
                  altText: entry.altText.trim(),
                  caption: entry.caption.trim() || null,
                  createdAtMs: nowMs,
                });
              }
              rows.media = mediaRows;
            }
            await persistence.insertPoll(rows);
          },
          generateId: () => crypto.randomUUID(),
          generateReference: generatePollReference,
          nowMs: () => nowMs,
          findExistingPoll: (pollId, ownerUserId) =>
            persistence.findPollForOwner(pollId, ownerUserId),
        },
        principal.userId as UserId,
        values,
      );
      if (result.ok) {
      // A fresh create always lands on the just-created outcome; a deduped
      // retry only while the Poll is still inside the freshness window.
      const suffix =
        !result.value.existing ||
        Date.now() - result.value.createdAtMs < RECENTLY_CREATED_WINDOW_MS
          ? "?created"
          : "";
      // Built manually so the no-store header rides along — an early
      // Astro.redirect return doesn't compose Astro.response.headers.
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${result.value.pollId}${suffix}`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.fieldErrors) {
      fieldErrors = result.error.fieldErrors;
      Astro.response.status = 422;
    } else if (result.error.code === "poll_duplicate_divergent") {
      // Back-button edit against an already-published nonce: show the error
      // and mint a fresh nonce so the next publish succeeds as a new Poll.
      formError = result.error.message;
      formPollId = crypto.randomUUID() as PollId;
      values.idempotencyId = formPollId;
      Astro.response.status = 422;
    } else {
      // Server-side persistence failure — not a client input problem
      // (AD-22: ≥500 registers as an error in telemetry).
      formError = result.error.message;
      Astro.response.status = 500;
    }
    }
  }
}

// Always render at least two option rows — the floor a Poll needs.
while (values.options.length < 2) {
  values.options = [...values.options, ""];
}
while ((values.slots?.length ?? 0) < 2) {
  values.slots = [...(values.slots ?? []), { date: "", start: "", end: "" }];
}
---

<BaseLayout title="Create a Poll — Oddspark Polls">
  <main class="create-shell">
    <h1>Create a Poll</h1>

    {formError && <p class="form-error" tabindex="-1" autofocus>{formError}</p>}

    <form method="post" action="/creator/new" enctype="multipart/form-data" data-create-poll-form novalidate>
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <input type="hidden" name="timezone" value={values.timeZone} />
      <input type="hidden" name="poll_id" value={formPollId} />
      {
        // PUBLISH is the first submit button in DOM order, so it is the
        // implicit Enter-key default; CSS order puts it back at the bottom.
      }
      <div class="publish-block">
        <ButtonPrimary type="submit" name="intent" value="publish">
          PUBLISH POLL
        </ButtonPrimary>
        <p class="helper-note">
          Your Poll is live the moment you publish — there is no draft.
        </p>
      </div>

      <PollDefinitionFields
        values={values}
        fieldErrors={fieldErrors}
        optionNote={optionNote}
        slotNote={slotNote}
        showPollType={true}
        pollTypeEditable={true}
        showDescription={false}
        tempMedia={tempMedia}
        pollId={formPollId}
      />

      <fieldset class="field-block" data-security-toggles>
        <legend class="group-label">SECURITY TOGGLES</legend>
        <div class="security-toggle-list">
          {
            SECURITY_TOGGLES.map((key) => (
              <SecurityToggle
                id={`create-security-${key}`}
                name={key}
                label={SECURITY_TOGGLE_META[key].name}
                description={SECURITY_TOGGLE_META[key].description}
                checked={values[key] === "true"}
              />
            ))
          }
        </div>
      </fieldset>

      <fieldset
        class="field-block"
        aria-describedby={fieldErrors.visibility ? "visibility-error" : undefined}
      >
        <legend class="group-label">WHO SEES THE RESULTS</legend>
        <div class="visibility-choices">
          {VISIBILITY_CHOICES.map((choice) => (
            <PollOption
              id={`visibility-${choice.value}`}
              name="visibility"
              value={choice.value}
              label={choice.label}
              description={choice.description}
              checked={values.resultVisibility === choice.value}
            />
          ))}
        </div>
        {fieldErrors.visibility && (
          <p class="field-error" id="visibility-error">{fieldErrors.visibility}</p>
        )}
      </fieldset>

      <fieldset
        class="field-block"
        aria-describedby={fieldErrors.listing ? "listing-error" : undefined}
      >
        <legend class="group-label">WHO CAN FIND IT</legend>
        <div class="listing-choices">
          {LISTING_CHOICES.map((choice) => (
            <PollOption
              id={`listing-${choice.value}`}
              name="listing"
              value={choice.value}
              label={choice.label}
              description={choice.description}
              checked={values.discoveryState === choice.value}
            />
          ))}
        </div>
        {fieldErrors.listing && (
          <p class="field-error" id="listing-error">{fieldErrors.listing}</p>
        )}
      </fieldset>

      <div class="field-block">
        <Input
          id="deadline"
          name="deadline"
          label="DEADLINE (OPTIONAL)"
          type="datetime-local"
          value={values.deadlineLocal}
          error={Boolean(fieldErrors.deadline)}
          describedby={fieldErrors.deadline ? "deadline-error" : undefined}
        />
        {fieldErrors.deadline && (
          <p class="field-error" id="deadline-error">
            {fieldErrors.deadline}
            {
              // A datetime-local input browser-sanitizes an invalid value to
              // blank — echo what was typed so it isn't lost.
              values.deadlineLocal.length > 0 && (
                <span> (You entered: {values.deadlineLocal})</span>
              )
            }
          </p>
        )}
      </div>

      <div class="field-block">
        <Input
          id="custom-link"
          name="customLink"
          label="CUSTOM LINK (OPTIONAL)"
          value={values.customLink}
          error={Boolean(fieldErrors.customLink)}
          autocapitalize="none"
          spellcheck="false"
          autocomplete="off"
          describedby={fieldErrors.customLink
            ? "custom-link-error custom-link-help"
            : "custom-link-help"}
        />
        {fieldErrors.customLink && (
          <p class="field-error" id="custom-link-error">
            {fieldErrors.customLink}
          </p>
        )}
        <p class="helper-note" id="custom-link-help">
          Lowercase letters, digits, and hyphens. Leave blank for a random link.
        </p>
      </div>

      <div class="field-block">
        <label class="group-label" for="description">DESCRIPTION (OPTIONAL)</label>
        <textarea
          class:list={["description-input", fieldErrors.description && "is-error"]}
          id="description"
          name="description"
          rows="4"
          aria-invalid={fieldErrors.description ? "true" : undefined}
          aria-describedby={fieldErrors.description ? "description-error" : undefined}
        >{values.description}</textarea>
        {fieldErrors.description && (
          <p class="field-error" id="description-error">{fieldErrors.description}</p>
        )}
      </div>
    </form>
  </main>
  <script src="../../scripts/create-poll-form.ts"></script>
</BaseLayout>

