---
import { env } from "cloudflare:workers";
import BaseLayout from "../../../layouts/base-layout.astro";
import ButtonSecondary from "../../../components/button-secondary.astro";
import ButtonDestructive from "../../../components/button-destructive.astro";
import LiveIndicator from "../../../components/live-indicator.astro";
import Overlay from "../../../components/overlay.astro";
import PollCard from "../../../components/poll-card.astro";
import PollDefinitionFields from "../../../components/poll-definition-fields.astro";
import { buildPollCardViewModel } from "../../../components/poll-card";
import { formatVoteTotal } from "../../../components/live-indicator";
import { createPollPersistence } from "../../../adapters/d1/index";
import { parseLifecycleForm } from "../../../lib/creator-lifecycle-form";
import {
  CREATE_POLL_COPY,
  LIFECYCLE_COPY,
  RECENTLY_CREATED_WINDOW_MS,
  closePoll,
  deletePoll,
  updatePollDefinition,
  updatePollDescription,
  type PollDefinitionDraft,
} from "../../../modules/polls/index";
import {
  POLL_CAPS,
  RENDER_OPTION_CEILING,
} from "../../../modules/polls/caps";
import {
  effectivePollStatus,
  type PollId,
  type UserId,
} from "../../../shared/domain/index";

// Creator detail + lifecycle (Stories 1.3 / 1.11 / 1.12). Never cached (AD-21).
Astro.response.headers.set("cache-control", "private, no-store");

if (
  Astro.request.method !== "GET" &&
  Astro.request.method !== "HEAD" &&
  Astro.request.method !== "POST"
) {
  return new Response("Method not allowed.", {
    status: 405,
    headers: {
      allow: "GET, HEAD, POST",
      "cache-control": "private, no-store",
    },
  });
}

const requestContext = Astro.locals.requestContext;
const principal = requestContext?.principal ?? null;
if (!principal) {
  return new Response(null, {
    status: 303,
    headers: {
      location: `/sign-in?return=${encodeURIComponent(Astro.url.pathname)}`,
      "cache-control": "private, no-store",
    },
  });
}

const nowMs = Date.now();
const ownerId = principal.userId as UserId;
const pollId = (Astro.params.pollId ?? "") as PollId;
const csrfToken = requestContext?.csrfToken?.value ?? "";
const persistence = createPollPersistence(env.DB);

type OutcomeKind =
  | "created"
  | "poll-updated"
  | "description-updated"
  | "poll-closed"
  | null;

let fieldErrors: Record<string, string> = {};
let formError: string | null = null;
let optionNote: string | null = null;
let outcome: OutcomeKind = null;
let draftValues: PollDefinitionDraft | null = null;
let forceLockedView = false;

// Ownership gate — set pollId on telemetry only after success.
let poll = await persistence.findPollForOwner(pollId, ownerId);
if (poll && requestContext) {
  requestContext.pollId = pollId;
}

const loadLifecycle = () =>
  persistence.loadLifecycleForOwner(pollId, ownerId);
const persistedDraft = (
  owned: NonNullable<typeof poll>,
  description = owned.description ?? "",
): PollDefinitionDraft => ({
  question: owned.question,
  description,
  options: owned.options.map((option) => option.label),
  multiSelect: owned.multiSelectEnabled ? "true" : "false",
  minSelections:
    owned.minSelections != null ? String(owned.minSelections) : "",
  maxSelections:
    owned.maxSelections != null ? String(owned.maxSelections) : "",
});

if (Astro.request.method === "POST") {
  let parsedForm;
  try {
    parsedForm = parseLifecycleForm(await Astro.request.formData());
  } catch {
    return new Response("Unreadable form submission.", {
      status: 422,
      headers: { "cache-control": "private, no-store" },
    });
  }

  const intent = parsedForm.intent;
  const submittedDraft: PollDefinitionDraft = {
    question: parsedForm.question,
    description: parsedForm.description,
    options: parsedForm.options,
    multiSelect: parsedForm.multiSelect,
    minSelections: parsedForm.minSelections,
    maxSelections: parsedForm.maxSelections,
  };

  if (!poll) {
    Astro.response.status = 404;
  } else if (intent === "add-option") {
    const lifecycle = await loadLifecycle();
    if (!lifecycle) {
      poll = null;
      Astro.response.status = 404;
    } else if (
      lifecycle.voterCount > 0 ||
      lifecycle.pollType !== "multiple_choice"
    ) {
      forceLockedView = true;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
      if (lifecycle.pollType !== "multiple_choice") {
        formError = LIFECYCLE_COPY.unsupportedPollType;
      }
    } else {
      draftValues = submittedDraft;
      const nonBlank = draftValues.options.filter(
        (option) => option.trim().length > 0,
      ).length;
      if (
        nonBlank < POLL_CAPS.maxOptions &&
        draftValues.options.length < RENDER_OPTION_CEILING
      ) {
        draftValues.options = [...draftValues.options, ""];
      } else {
        optionNote =
          nonBlank >= POLL_CAPS.maxOptions
            ? CREATE_POLL_COPY.optionsTooMany
            : CREATE_POLL_COPY.rowsTooMany;
      }
    }
  } else if (intent === "close") {
    const result = await closePoll(
      {
        loadOwnedPoll: loadLifecycle,
        closePoll: (input) => persistence.closePollForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${pollId}?outcome=poll-closed`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "delete") {
    const result = await deletePoll(
      {
        loadOwnedPoll: loadLifecycle,
        deletePoll: (input) => persistence.deletePollForOwner(input),
      },
      pollId,
      ownerId,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: "/creator?outcome=poll-deleted",
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-description") {
    const description = parsedForm.description;
    draftValues = persistedDraft(poll, description);
    const result = await updatePollDescription(
      {
        loadOwnedPoll: loadLifecycle,
        updateDescription: (input) =>
          persistence.updateDescriptionForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
      description,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${pollId}?outcome=description-updated`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (result.error.fieldErrors) {
      fieldErrors = result.error.fieldErrors;
      Astro.response.status = 422;
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-definition") {
    const submittedPollType = parsedForm.pollType;
    if (
      submittedPollType !== null &&
      submittedPollType !== "multiple_choice"
    ) {
      formError = LIFECYCLE_COPY.unsupportedPollType;
      Astro.response.status = 422;
    }
    draftValues = submittedDraft;
    const result = formError
      ? null
      : await updatePollDefinition(
      {
        loadOwnedPoll: loadLifecycle,
        updateDefinition: (input) =>
          persistence.updateDefinitionForOwner(input),
        updateDescription: (input) =>
          persistence.updateDescriptionForOwner(input),
        generateId: () => crypto.randomUUID(),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
      draftValues,
    );
    if (result?.ok) {
      const location =
        result.value.kind === "description_only"
          ? `/creator/polls/${pollId}?outcome=description-updated`
          : `/creator/polls/${pollId}?outcome=poll-updated`;
      return new Response(null, {
        status: 303,
        headers: {
          location,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result && !result.ok && result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_definition_locked"
    ) {
      // First Vote won the race: switch to locked view, keep submitted description.
      forceLockedView = true;
      fieldErrors = {};
      formError = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_definition_conflict"
    ) {
      formError = result.error.message;
      fieldErrors = {};
      draftValues = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_type_unsupported"
    ) {
      formError = result.error.message;
      draftValues = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        forceLockedView = true;
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
    } else if (result && !result.ok && result.error.fieldErrors) {
      fieldErrors = result.error.fieldErrors;
      Astro.response.status = 422;
    } else if (result && !result.ok) {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  }
}

// Fresh list after mutations that stay on the page.
const ownedPolls = await persistence.listPollsForOwner(ownerId, nowMs);
const selectedListRow = ownedPolls.find((row) => row.pollId === pollId) ?? null;

if (!poll) {
  Astro.response.status = 404;
}

const created =
  poll !== null &&
  Astro.url.searchParams.get("created") === "" &&
  nowMs - poll.createdAtMs < RECENTLY_CREATED_WINDOW_MS;

const outcomeParam = Astro.url.searchParams.get("outcome");
if (created) {
  outcome = "created";
} else if (outcomeParam === "poll-updated") {
  outcome = "poll-updated";
} else if (outcomeParam === "description-updated") {
  outcome = "description-updated";
} else if (outcomeParam === "poll-closed") {
  outcome = "poll-closed";
}

const confirmDelete = Astro.url.searchParams.get("confirm") === "delete";

// The lifecycle snapshot is the last owner-qualified existence check before
// rendering. If a concurrent delete won after the initial detail read, render
// the ordinary missing state instead of stale Poll data.
const lifecycleSnapshot = poll
  ? await persistence.loadLifecycleForOwner(pollId, ownerId)
  : null;
if (poll && !lifecycleSnapshot) {
  poll = null;
  Astro.response.status = 404;
}

const canonicalUrl = poll
  ? `${Astro.url.origin}/${poll.canonicalReference}`
  : null;
const deadlineNote =
  poll?.deadlineMs != null
    ? (() => {
        const iso = new Date(poll.deadlineMs).toISOString();
        return `Voting closes ${iso.slice(0, 10)} ${iso.slice(11, 19)} UTC.`;
      })()
    : null;

const detailStatus =
  poll !== null ? effectivePollStatus(poll, nowMs) : null;
// Prefer the lifecycle snapshot (same owner-qualified vote count as mutation
// guards) over the list row so lock state never drifts from D1 truth.
const voterCount =
  lifecycleSnapshot?.voterCount ?? selectedListRow?.voterCount ?? 0;
const definitionLocked =
  forceLockedView ||
  voterCount > 0 ||
  (poll !== null && poll.pollType !== "multiple_choice");

const listCards = ownedPolls.map((row) =>
  buildPollCardViewModel({
    title: row.question,
    pollType: row.pollType,
    voterCount: row.voterCount,
    status: effectivePollStatus(row, nowMs),
    deadlineMs: row.deadlineMs,
    nowMs,
    href: `/creator/polls/${row.pollId}`,
    current: poll !== null && row.pollId === pollId,
  }),
);

const formValues: PollDefinitionDraft = draftValues ?? {
  question: poll?.question ?? "",
  description: poll?.description ?? "",
  options:
    poll?.options.map((option) => option.label) ??
    Array.from({ length: 2 }, () => ""),
  multiSelect: poll?.multiSelectEnabled ? "true" : "false",
  minSelections:
    poll?.minSelections != null ? String(poll.minSelections) : "",
  maxSelections:
    poll?.maxSelections != null ? String(poll.maxSelections) : "",
};

while (formValues.options.length < 2) {
  formValues.options = [...formValues.options, ""];
}

const outcomeCopy: Record<Exclude<OutcomeKind, null>, string> = {
  created: "Your Poll is live.",
  "poll-updated": "Poll updated.",
  "description-updated": "Description updated.",
  "poll-closed": "Poll closed.",
};

const title = poll
  ? outcome
    ? `${outcomeCopy[outcome].replace(/\.$/, "")} — Oddspark Polls`
    : `${poll.question} — Oddspark Polls`
  : "Not found — Oddspark Polls";

const deleteHeading = poll
  ? `Delete "${poll.question}"?`
  : 'Delete "this Poll"?';
const deleteBody = `This removes the Poll and all ${voterCount} Votes in it. The link stops resolving. There is no undo.`;
const detailPath = `/creator/polls/${pollId}`;
---

<BaseLayout title={title}>
  <main
    class:list={[
      "creator-surface",
      { "has-created-outcome": outcome !== null },
    ]}
    data-creator-surface
  >
    {
      outcome && (
        <p
          class="outcome-line"
          data-outcome={outcome === "created" ? "created" : outcome}
          tabindex="-1"
          autofocus
        >
          {outcomeCopy[outcome]}
        </p>
      )
    }

    <section
      class="creator-list-region"
      aria-labelledby="creator-list-heading"
      data-creator-list
    >
      <div class="list-region-header">
        <h2 id="creator-list-heading" class="list-heading">Your Polls</h2>
        <a class="list-create-link" href="/creator/new">CREATE A POLL</a>
      </div>
      {
        listCards.length === 0 ? (
          <p class="empty-state">
            No Polls yet. The empty state, working as intended.
          </p>
        ) : (
          <ul class="poll-list" data-poll-list>
            {listCards.map((card) => (
              <li>
                <PollCard viewModel={card} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section
      class="creator-detail-region"
      aria-labelledby="poll-detail-heading"
      data-creator-detail
    >
      {
        poll && detailStatus ? (
          <>
            <p class="detail-status" data-detail-status>
              <LiveIndicator status={detailStatus}>
                <span>{formatVoteTotal(voterCount)}</span>
                <span aria-hidden="true"> · </span>
              </LiveIndicator>
            </p>
            <h1 id="poll-detail-heading">{poll.question}</h1>
            {formError && (
              <p class="form-error" tabindex="-1" autofocus>
                {formError}
              </p>
            )}

            <section class="link-block" aria-labelledby="poll-link-label">
              <p class="group-label" id="poll-link-label">POLL LINK</p>
              <p class="canonical-url">{canonicalUrl}</p>
              <p class="helper-note">
                This is the link you'll share when voting opens. Its reference
                never changes.
              </p>
              {deadlineNote && <p class="helper-note">{deadlineNote}</p>}
            </section>

            <form
              method="post"
              action={detailPath}
              class="lifecycle-form"
              data-edit-poll-form={!definitionLocked ? true : undefined}
              data-edit-description-form={definitionLocked ? true : undefined}
              data-poll-definition-form
              novalidate
            >
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <PollDefinitionFields
                values={formValues}
                fieldErrors={fieldErrors}
                optionNote={optionNote}
                pollTypeLabel={poll.pollType.replaceAll("_", " ").toUpperCase()}
                locked={definitionLocked}
                lockMessage={
                  poll.pollType !== "multiple_choice"
                    ? LIFECYCLE_COPY.unsupportedPollType
                    : definitionLocked
                      ? LIFECYCLE_COPY.definitionLocked
                      : null
                }
                showSave={true}
                saveLabel="SAVE CHANGES"
              />
            </form>

            <div class="lifecycle-actions">
              {
                detailStatus === "open" && (
                  <form method="post" action={detailPath}>
                    <input type="hidden" name="csrf_token" value={csrfToken} />
                    <ButtonSecondary type="submit" name="intent" value="close">
                      CLOSE POLL
                    </ButtonSecondary>
                  </form>
                )
              }
              <ButtonSecondary
                href={`${detailPath}?confirm=delete`}
                id="delete-poll-invoker"
                aria-haspopup="dialog"
                aria-controls="delete-poll-overlay"
                data-overlay-open-for="delete-poll-overlay"
              >
                DELETE POLL
              </ButtonSecondary>
              <p class="results-link-row">
                <ButtonSecondary href={`/${poll.canonicalReference}/results`}>
                  VIEW LIVE RESULTS
                </ButtonSecondary>
              </p>
            </div>

            <Overlay
              id="delete-poll-overlay"
              open={confirmDelete}
              titleId="delete-poll-title"
              descriptionId="delete-poll-description"
              title={deleteHeading}
            >
              <p slot="description">{deleteBody}</p>
              <div slot="actions" class="overlay-action-row">
                <ButtonSecondary
                  href={detailPath}
                  data-overlay-cancel={true}
                >
                  CANCEL
                </ButtonSecondary>
                <form method="post" action={detailPath}>
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <ButtonDestructive type="submit" name="intent" value="delete">
                    DELETE POLL
                  </ButtonDestructive>
                </form>
              </div>
            </Overlay>
          </>
        ) : (
          <h1
            id="poll-detail-heading"
            class="outcome-line"
            tabindex="-1"
            autofocus
          >
            This Poll doesn't exist.
          </h1>
        )
      }
    </section>
  </main>
  {
    listCards.some((card) => card.metadata.closing.kind === "absolute") && (
      <script src="../../../scripts/creator-dashboard.ts"></script>
    )
  }
  {
    poll && (
      <>
        <script src="../../../scripts/edit-poll-form.ts"></script>
        <script src="../../../scripts/overlay.ts"></script>
      </>
    )
  }
</BaseLayout>

<style>
  .creator-surface {
    width: min(100%, var(--space-measure));
    margin-inline: auto;
    padding: var(--space-8) var(--space-margin-mobile) var(--space-section-gap);
  }

  .creator-list-region {
    margin-bottom: var(--space-10);
  }

  .list-region-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .list-heading {
    margin: 0;
    font-family: var(--font-human);
    font-size: var(--type-heading-md-size);
    font-weight: 400;
    line-height: var(--type-heading-md-lh);
  }

  .list-create-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    text-decoration: none;
  }

  .list-create-link:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .empty-state {
    margin: 0;
    color: var(--color-dim);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .poll-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcome-line {
    margin: 0 0 var(--space-6);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-lh);
  }

  .detail-status {
    margin: 0 0 var(--space-3);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-human);
    font-size: var(--type-heading-lg-size);
    font-weight: 400;
    line-height: var(--type-heading-lg-lh);
  }

  .link-block {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-2);
  }

  .group-label {
    margin: 0;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
  }

  .canonical-url {
    margin: 0;
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
    user-select: all;
    overflow-wrap: anywhere;
  }

  .helper-note {
    margin: 0;
    color: var(--color-dim);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .lifecycle-form {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-8);
  }

  .lifecycle-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .results-link-row {
    margin: 0;
  }

  .form-error {
    margin: 0 0 var(--space-4);
    color: var(--color-alarm);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  @media (min-width: 640px) {
    .creator-surface {
      padding-inline: var(--space-margin-desktop);
    }
  }

  @media (min-width: 1024px) {
    .creator-surface {
      display: grid;
      grid-template-columns: 320px 1fr;
      column-gap: var(--space-8);
      align-items: start;
      width: 100%;
      max-width: none;
    }

    .creator-list-region {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .creator-detail-region {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: var(--space-measure);
      min-width: 0;
    }

    .has-created-outcome > .outcome-line {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: var(--space-measure);
    }

    .has-created-outcome > .creator-list-region {
      grid-row: 1 / span 2;
    }

    .has-created-outcome > .creator-detail-region {
      grid-row: 2;
    }
  }
</style>
