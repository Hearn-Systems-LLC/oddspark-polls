---
import { env } from "cloudflare:workers";
import BaseLayout from "../../../layouts/base-layout.astro";
import ButtonSecondary from "../../../components/button-secondary.astro";
import ButtonDestructive from "../../../components/button-destructive.astro";
import AvailabilityTally from "../../../components/availability-tally.astro";
import LiveIndicator from "../../../components/live-indicator.astro";
import ListingBadge from "../../../components/listing-badge.astro";
import Overlay from "../../../components/overlay.astro";
import PollCard from "../../../components/poll-card.astro";
import PollDefinitionFields from "../../../components/poll-definition-fields.astro";
import PollOption from "../../../components/poll-option.astro";
import SecurityToggle from "../../../components/security-toggle.astro";
import ShareAction from "../../../components/share-action.astro";
import { buildPollCardViewModel } from "../../../components/poll-card";
import { formatVoteTotal } from "../../../components/live-indicator";
import {
  createPollPersistence,
  createResultsPersistence,
} from "../../../adapters/d1/index";
import { createDemoPollPersistence } from "../../../adapters/d1/demo-poll";
import { parseLifecycleForm } from "../../../lib/creator-lifecycle-form";
import {
  DEMO_RESET_FLASH_COOKIE_NAME,
  createDemoResetFlash,
  verifyDemoResetFlash,
} from "../../../lib/demo-reset-flash";
import {
  CREATE_POLL_COPY,
  DEMO_POLL_COPY,
  LIFECYCLE_COPY,
  RECENTLY_CREATED_WINDOW_MS,
  SECURITY_COPY,
  SECURITY_TOGGLE_META,
  closePoll,
  deletePoll,
  isDemoPollCompatible,
  isUsableTimeZone,
  resetDemoPoll,
  validateDemoPollReference,
  parseSecurityToggleDraft,
  snapshotSecurityToggles,
  updatePollDefinition,
  updatePollDescription,
  updatePollSecurityToggles,
  type PollDefinitionDraft,
} from "../../../modules/polls/index";
import { queryResults } from "../../../modules/results/index";
import {
  POLL_CAPS,
  RENDER_OPTION_CEILING,
} from "../../../modules/polls/caps";
import {
  DISCOVERY_COPY,
  LISTING_CHOICES,
  parseListingDraft,
  setPollListing,
} from "../../../modules/discovery/index";
import {
  SECURITY_TOGGLES,
  effectivePollStatus,
  type PollId,
  type PollSecurityToggles,
  type UserId,
} from "../../../shared/domain/index";

// Creator detail + lifecycle (Stories 1.3 / 1.11 / 1.12). Never cached (AD-21).
Astro.response.headers.set("cache-control", "private, no-store");

if (
  Astro.request.method !== "GET" &&
  Astro.request.method !== "HEAD" &&
  Astro.request.method !== "POST"
) {
  return new Response("Method not allowed.", {
    status: 405,
    headers: {
      allow: "GET, HEAD, POST",
      "cache-control": "private, no-store",
    },
  });
}

const requestContext = Astro.locals.requestContext;
const principal = requestContext?.principal ?? null;
if (!principal) {
  return new Response(null, {
    status: 303,
    headers: {
      location: `/sign-in?return=${encodeURIComponent(Astro.url.pathname)}`,
      "cache-control": "private, no-store",
    },
  });
}

const nowMs = Date.now();
const ownerId = principal.userId as UserId;
const pollId = (Astro.params.pollId ?? "") as PollId;
const csrfToken = requestContext?.csrfToken?.value ?? "";
const persistence = createPollPersistence(env.DB);
const demoPersistence = createDemoPollPersistence(env.DB);

type OutcomeKind =
  | "created"
  | "poll-updated"
  | "description-updated"
  | "poll-closed"
  | "security-updated"
  | "listing-updated"
  | "demo-reset"
  | null;

let fieldErrors: Record<string, string> = {};
let formError: string | null = null;
let optionNote: string | null = null;
let outcome: OutcomeKind = null;
let draftValues: PollDefinitionDraft | null = null;
let forceLockedView = false;
/** Rejected security draft must never re-render as truth (1.12 lock race). */
let securityDraft: PollSecurityToggles | null = null;
let forceSecurityFromPersisted = false;
/** Established only by the owner-qualified listing command policy result. */
let listingPolicyResolvedDelisted = false;

const DELISTED_CREATOR_COPY =
  "Delisted by the Administrator. The link still works and Votes still count; the Poll no longer appears on Discover. Only the Administrator can reverse this.";

// Ownership gate — set pollId on telemetry only after success.
let poll = await persistence.findPollForOwner(pollId, ownerId);
if (poll && requestContext) {
  requestContext.pollId = pollId;
}

const loadLifecycle = () =>
  persistence.loadLifecycleForOwner(pollId, ownerId);
const persistedDraft = (
  owned: NonNullable<typeof poll>,
  description = owned.description ?? "",
): PollDefinitionDraft => ({
  pollType: owned.pollType,
  question: owned.question,
  description,
  options: owned.options.map((option) => option.label),
  multiSelect: owned.multiSelectEnabled ? "true" : "false",
  minSelections:
    owned.minSelections != null ? String(owned.minSelections) : "",
  maxSelections:
    owned.maxSelections != null ? String(owned.maxSelections) : "",
  commentsEnabled: owned.commentsEnabled ? "true" : "false",
});

if (Astro.request.method === "POST") {
  let parsedForm;
  try {
    parsedForm = parseLifecycleForm(await Astro.request.formData());
  } catch {
    return new Response("Unreadable form submission.", {
      status: 422,
      headers: { "cache-control": "private, no-store" },
    });
  }

  const intent = parsedForm.intent;
  const submittedDraft: PollDefinitionDraft = {
    pollType: parsedForm.pollType ?? poll?.pollType ?? "multiple_choice",
    question: parsedForm.question,
    description: parsedForm.description,
    options: parsedForm.options,
    multiSelect: parsedForm.multiSelect,
    minSelections: parsedForm.minSelections,
    maxSelections: parsedForm.maxSelections,
    commentsEnabled: parsedForm.commentsEnabled,
  };

  if (intent === "reset-demo") {
    const result = await resetDemoPoll(
      {
        loadByReference: demoPersistence.loadByReference,
        replace: demoPersistence.replace,
      },
      {
        configuredReference: env.DEMO_POLL_REFERENCE,
        requestedPollId: pollId,
        ownerUserId: ownerId,
      },
    );
    if (result.ok) {
      if (result.value.kind === "replaced") {
        const resetFlash = await createDemoResetFlash(
          env.BETTER_AUTH_SECRET,
          {
            sessionId: principal.session.id,
            ownerUserId: ownerId,
            pollId: result.value.pollId,
            representationVersion: result.value.representationVersion,
          },
        );
        return new Response(null, {
          status: 303,
          headers: {
            location: `/creator/polls/${result.value.pollId}`,
            "cache-control": "private, no-store",
            "set-cookie": `${DEMO_RESET_FLASH_COOKIE_NAME}=${resetFlash}; Path=/creator/polls/; Max-Age=60; HttpOnly; SameSite=Lax${Astro.url.protocol === "https:" ? "; Secure" : ""}`,
          },
        });
      }
      const targetPollId =
        result.value.kind === "stale"
          ? result.value.currentPollId
          : result.value.pollId;
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${targetPollId}`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "demo_reset_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (
      result.error.code === "demo_reset_closed" ||
      result.error.code === "demo_reset_moderated" ||
      result.error.code === "demo_reset_ineligible" ||
      result.error.code === "demo_reset_stale"
    ) {
      formError = result.error.message;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
      poll = await persistence.findPollForOwner(pollId, ownerId);
    }
  } else if (!poll) {
    Astro.response.status = 404;
  } else if (intent === "add-option") {
    const lifecycle = await loadLifecycle();
    if (!lifecycle) {
      poll = null;
      Astro.response.status = 404;
    } else if (lifecycle.voterCount > 0) {
      forceLockedView = true;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
    } else {
      draftValues = submittedDraft;
      const nonBlank = draftValues.options.filter(
        (option) => option.trim().length > 0,
      ).length;
      if (
        nonBlank < POLL_CAPS.maxOptions &&
        draftValues.options.length < RENDER_OPTION_CEILING
      ) {
        draftValues.options = [...draftValues.options, ""];
      } else {
        optionNote =
          nonBlank >= POLL_CAPS.maxOptions
            ? CREATE_POLL_COPY.optionsTooMany
            : CREATE_POLL_COPY.rowsTooMany;
      }
    }
  } else if (intent === "close") {
    const result = await closePoll(
      {
        loadOwnedPoll: loadLifecycle,
        closePoll: (input) => persistence.closePollForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${pollId}?outcome=poll-closed`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "delete") {
    const result = await deletePoll(
      {
        loadOwnedPoll: loadLifecycle,
        deletePoll: (input) => persistence.deletePollForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: "/creator?outcome=poll-deleted",
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-description") {
    const description = parsedForm.description;
    draftValues = persistedDraft(poll, description);
    const submittedPollType = parsedForm.pollType;
    if (submittedPollType !== null && submittedPollType !== poll.pollType) {
      formError = LIFECYCLE_COPY.unsupportedPollType;
      Astro.response.status = 422;
    }
    const result = formError ? null : await updatePollDescription(
      {
        loadOwnedPoll: loadLifecycle,
        updateDescription: (input) =>
          persistence.updateDescriptionForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
      description,
    );
    if (result?.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${pollId}?outcome=description-updated`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result && !result.ok && result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (result && !result.ok && result.error.fieldErrors) {
      fieldErrors = result.error.fieldErrors;
      Astro.response.status = 422;
    } else if (result && !result.ok) {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-definition") {
    const submittedPollType = parsedForm.pollType;
    if (submittedPollType !== null && submittedPollType !== poll.pollType) {
      formError = LIFECYCLE_COPY.unsupportedPollType;
      Astro.response.status = 422;
    }
    draftValues = submittedDraft;
    const result = formError
      ? null
      : await updatePollDefinition(
      {
        loadOwnedPoll: loadLifecycle,
        updateDefinition: (input) =>
          persistence.updateDefinitionForOwner(input),
        updateDescription: (input) =>
          persistence.updateDescriptionForOwner(input),
        generateId: () => crypto.randomUUID(),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
      draftValues,
    );
    if (result?.ok) {
      const location =
        result.value.kind === "description_only"
          ? `/creator/polls/${pollId}?outcome=description-updated`
          : `/creator/polls/${pollId}?outcome=poll-updated`;
      return new Response(null, {
        status: 303,
        headers: {
          location,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result && !result.ok && result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_definition_locked"
    ) {
      // First Vote won the race: switch to locked view, keep submitted description.
      forceLockedView = true;
      fieldErrors = {};
      formError = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_definition_conflict"
    ) {
      formError = result.error.message;
      fieldErrors = {};
      draftValues = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
    } else if (
      result &&
      !result.ok &&
      result.error.code === "poll_type_unsupported"
    ) {
      formError = result.error.message;
      draftValues = null;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
      if (poll) {
        forceLockedView = true;
        draftValues = persistedDraft(poll, submittedDraft.description);
      }
    } else if (result && !result.ok && result.error.fieldErrors) {
      fieldErrors = result.error.fieldErrors;
      Astro.response.status = 422;
    } else if (result && !result.ok) {
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-security") {
    const requested = parseSecurityToggleDraft({
      sessionChecks: parsedForm.sessionChecks,
      ipChecks: parsedForm.ipChecks,
      voterCodes: parsedForm.voterCodes,
      captcha: parsedForm.captcha,
      vpnBlocking: parsedForm.vpnBlocking,
    });
    securityDraft = requested;
    const result = await updatePollSecurityToggles(
      {
        loadOwnedPoll: loadLifecycle,
        updateSecurityToggles: (input) =>
          persistence.updateSecurityTogglesForOwner(input),
        nowMs: () => nowMs,
      },
      pollId,
      ownerId,
      requested,
    );
    if (result.ok) {
      return new Response(null, {
        status: 303,
        headers: {
          location: `/creator/polls/${pollId}?outcome=security-updated`,
          "cache-control": "private, no-store",
        },
      });
    }
    if (result.error.code === "poll_not_found") {
      poll = null;
      Astro.response.status = 404;
    } else if (result.error.code === "poll_security_locked") {
      // Race or forged disable: re-render persisted truth, never the draft.
      forceSecurityFromPersisted = true;
      securityDraft = null;
      formError = SECURITY_COPY.locked;
      Astro.response.status = 422;
      poll = await persistence.findPollForOwner(pollId, ownerId);
    } else {
      // A failed write means none of the submitted values are trustworthy.
      // Re-render the fresh lifecycle snapshot so a voted Poll cannot present
      // an unpersisted protection as checked and LOCKED.
      forceSecurityFromPersisted = true;
      securityDraft = null;
      formError = result.error.message;
      Astro.response.status = 500;
    }
  } else if (intent === "update-listing") {
    const requested = parseListingDraft(parsedForm.listing);
    if (requested === null) {
      fieldErrors = { listing: DISCOVERY_COPY.listingInvalid };
      Astro.response.status = 422;
    } else {
      const result = await setPollListing(
        {
          loadOwnedPoll: loadLifecycle,
          updateListing: (input) => persistence.updateListingForOwner(input),
          nowMs: () => nowMs,
        },
        pollId,
        ownerId,
        requested,
      );
      if (result.ok) {
        return new Response(null, {
          status: 303,
          headers: {
            location: `/creator/polls/${pollId}?outcome=listing-updated`,
            "cache-control": "private, no-store",
          },
        });
      }
      if (result.error.code === "poll_not_found") {
        poll = null;
        Astro.response.status = 404;
      } else if (result.error.code === "poll_delisted") {
        // Policy rejection renders owner-qualified persisted truth, never the
        // rejected creator draft (the administrator owns delisted). Keep the
        // known owner-qualified Poll if a concurrent reference read is
        // temporarily unavailable. This resolved policy state may also supply
        // only the Delisted presentation if the final lifecycle read fails.
        listingPolicyResolvedDelisted = true;
        formError = null;
        Astro.response.status = 422;
        let refreshedPoll = null;
        try {
          refreshedPoll = await persistence.findPollForOwner(pollId, ownerId);
        } catch {
          // The owner-qualified policy result already established the safe
          // Delisted presentation. The final lifecycle read below still gets
          // the next opportunity to provide fresh persisted truth.
        }
        if (refreshedPoll) {
          poll = refreshedPoll;
        }
      } else {
        formError = result.error.message;
        Astro.response.status = 500;
        poll = await persistence.findPollForOwner(pollId, ownerId);
      }
    }
  }
}

// Fresh list after mutations that stay on the page.
const ownedPolls = await persistence.listPollsForOwner(ownerId, nowMs);
const selectedListRow = ownedPolls.find((row) => row.pollId === pollId) ?? null;

if (!poll) {
  Astro.response.status = 404;
}

const created =
  poll !== null &&
  Astro.url.searchParams.get("created") === "" &&
  nowMs - poll.createdAtMs < RECENTLY_CREATED_WINDOW_MS;

const outcomeParam = Astro.url.searchParams.get("outcome");
if (created) {
  outcome = "created";
} else if (outcomeParam === "poll-updated") {
  outcome = "poll-updated";
} else if (outcomeParam === "description-updated") {
  outcome = "description-updated";
} else if (outcomeParam === "poll-closed") {
  outcome = "poll-closed";
} else if (outcomeParam === "security-updated") {
  outcome = "security-updated";
} else if (outcomeParam === "listing-updated") {
  outcome = "listing-updated";
}

const confirmDelete = Astro.url.searchParams.get("confirm") === "delete";

// The lifecycle snapshot is the last owner-qualified existence check before
// rendering. If a concurrent delete won after the initial detail read, render
// the ordinary missing state instead of stale Poll data.
let lifecycleSnapshot: Awaited<ReturnType<typeof loadLifecycle>> = null;
if (poll) {
  try {
    lifecycleSnapshot = await persistence.loadLifecycleForOwner(pollId, ownerId);
  } catch (error) {
    if (!listingPolicyResolvedDelisted) {
      throw error;
    }
  }
}
if (poll && !lifecycleSnapshot && !listingPolicyResolvedDelisted) {
  poll = null;
  Astro.response.status = 404;
}

const configuredDemoReference = validateDemoPollReference(
  env.DEMO_POLL_REFERENCE,
);
const configuredDemoSnapshot = configuredDemoReference.ok
  ? await demoPersistence.loadByReference(configuredDemoReference.value)
  : null;
const isCurrentDesignatedDemo =
  poll !== null &&
  configuredDemoSnapshot !== null &&
  configuredDemoSnapshot.pollId === pollId &&
  configuredDemoSnapshot.ownerUserId === ownerId;
const demoResetEmpty =
  isCurrentDesignatedDemo && configuredDemoSnapshot?.voterCount === 0;
const demoResetPolicyEligible =
  isCurrentDesignatedDemo &&
  configuredDemoSnapshot !== null &&
  isDemoPollCompatible(configuredDemoSnapshot) &&
  configuredDemoSnapshot.closedAtMs === null &&
  configuredDemoSnapshot.discoveryState !== "delisted" &&
  configuredDemoSnapshot.moderationActionCount === 0;
const confirmResetDemo =
  Astro.url.searchParams.get("confirm") === "reset-demo" &&
  demoResetPolicyEligible &&
  !demoResetEmpty;

let demoResetOutcomeBody = DEMO_POLL_COPY.resetSuccessEmpty;
const resetFlash = Astro.cookies.get(DEMO_RESET_FLASH_COOKIE_NAME)?.value;
if (Astro.request.method === "GET" && resetFlash) {
  Astro.response.headers.append(
    "set-cookie",
    `${DEMO_RESET_FLASH_COOKIE_NAME}=; Path=/creator/polls/; Max-Age=0; HttpOnly; SameSite=Lax${Astro.url.protocol === "https:" ? "; Secure" : ""}`,
  );
  if (poll && lifecycleSnapshot) {
    const resetVersion = await verifyDemoResetFlash(
      env.BETTER_AUTH_SECRET,
      resetFlash,
      {
        sessionId: principal.session.id,
        ownerUserId: ownerId,
        pollId,
        representationVersion: lifecycleSnapshot.representationVersion,
      },
    );
    if (resetVersion !== null) {
      outcome = "demo-reset";
      demoResetOutcomeBody =
        lifecycleSnapshot.voterCount === 0
          ? DEMO_POLL_COPY.resetSuccessEmpty
          : DEMO_POLL_COPY.resetSuccessRaced;
    }
  }
}

const canonicalUrl = poll
  ? `${Astro.url.origin}/${poll.canonicalReference}`
  : null;
const deadlineNote =
  poll?.deadlineMs != null
    ? (() => {
        const iso = new Date(poll.deadlineMs).toISOString();
        return `Voting closes ${iso.slice(0, 10)} ${iso.slice(11, 19)} UTC.`;
      })()
    : null;

const detailStatus =
  poll !== null ? effectivePollStatus(poll, nowMs) : null;
// Prefer the lifecycle snapshot (same owner-qualified vote count as mutation
// guards) over the list row so lock state never drifts from D1 truth.
const voterCount =
  lifecycleSnapshot?.voterCount ?? selectedListRow?.voterCount ?? 0;
const isEditablePollType =
  poll?.pollType === "multiple_choice" ||
  poll?.pollType === "ranked_choice";
const definitionLocked =
  forceLockedView ||
  voterCount > 0 ||
  !isEditablePollType;

const meetingTimeZone = poll?.slots?.[0]?.timeZone ?? null;
const creatorMeetingTimeZone =
  meetingTimeZone && isUsableTimeZone(meetingTimeZone)
    ? meetingTimeZone
    : "UTC";
const meetingSlotRows = (poll?.slots ?? []).map((slot) => {
  const formatter = new Intl.DateTimeFormat("en-US", {
    timeZone: creatorMeetingTimeZone,
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
  const start = formatter.format(new Date(slot.startsAtMs));
  const end = new Intl.DateTimeFormat("en-US", {
    timeZone: creatorMeetingTimeZone,
    hour: "numeric",
    minute: "2-digit",
  }).format(new Date(slot.endsAtMs));
  return `${start}–${end}`;
});

const creatorMeetingQuery =
  poll?.pollType === "meeting"
    ? await queryResults(
        createResultsPersistence(env.DB),
        poll.canonicalReference,
        { userId: ownerId },
        nowMs,
      )
    : null;
const creatorMeetingResults =
  creatorMeetingQuery?.kind === "meeting_visible"
    ? creatorMeetingQuery
    : null;

const listCards = ownedPolls.map((row) =>
  buildPollCardViewModel({
    title: row.question,
    pollType: row.pollType,
    voterCount: row.voterCount,
    status: effectivePollStatus(row, nowMs),
    deadlineMs: row.deadlineMs,
    nowMs,
    href: `/creator/polls/${row.pollId}`,
    current: poll !== null && row.pollId === pollId,
    listing: row.discoveryState,
  }),
);

const formValues: PollDefinitionDraft = draftValues ?? {
  pollType: poll?.pollType ?? "multiple_choice",
  question: poll?.question ?? "",
  description: poll?.description ?? "",
  options:
    poll?.options.map((option) => option.label) ??
    Array.from({ length: 2 }, () => ""),
  slots: [],
  timeZone: meetingTimeZone ?? "",
  multiSelect: poll?.multiSelectEnabled ? "true" : "false",
  minSelections:
    poll?.minSelections != null ? String(poll.minSelections) : "",
  maxSelections:
    poll?.maxSelections != null ? String(poll.maxSelections) : "",
  commentsEnabled: poll?.commentsEnabled ? "true" : "false",
};

while (formValues.options.length < 2) {
  formValues.options = [...formValues.options, ""];
}

const outcomeCopy: Record<Exclude<OutcomeKind, null>, string> = {
  created: "Your Poll is live.",
  "poll-updated": "Poll updated.",
  "description-updated": "Description updated.",
  "poll-closed": "Poll closed.",
  "security-updated": "Security updated.",
  "listing-updated": "Listing updated.",
  "demo-reset": demoResetOutcomeBody,
};

const listingState =
  lifecycleSnapshot?.discoveryState ??
  (listingPolicyResolvedDelisted ? "delisted" : poll?.discoveryState);

const persistedSecurity: PollSecurityToggles | null = lifecycleSnapshot
  ? snapshotSecurityToggles(lifecycleSnapshot)
  : poll
    ? {
        sessionChecks: poll.sessionChecksEnabled,
        ipChecks: poll.ipChecksEnabled,
        voterCodes: poll.voterCodesEnabled,
        captcha: poll.captchaEnabled,
        vpnBlocking: poll.vpnBlockingEnabled,
      }
    : null;

const securityValues: PollSecurityToggles =
  forceSecurityFromPersisted || !securityDraft
    ? (persistedSecurity ?? {
        sessionChecks: true,
        ipChecks: false,
        voterCodes: false,
        captcha: false,
        vpnBlocking: false,
      })
    : securityDraft;

const securityVotesIn = voterCount > 0;

const title = poll
  ? outcome
    ? outcome === "demo-reset"
      ? `${DEMO_POLL_COPY.resetSuccessHeading} — Oddspark Polls`
      : `${outcomeCopy[outcome].replace(/\.$/, "")} — Oddspark Polls`
    : `${poll.question} — Oddspark Polls`
  : "Not found — Oddspark Polls";

const deleteHeading = poll
  ? `Delete "${poll.question}"?`
  : 'Delete "this Poll"?';
const deleteBody = `This removes the Poll and all ${voterCount} Votes in it. The link stops resolving. There is no undo.`;
const detailPath = `/creator/polls/${pollId}`;
---

<BaseLayout title={title}>
  <main
    class:list={[
      "creator-surface",
      { "has-created-outcome": outcome !== null },
    ]}
    data-creator-surface
  >
    {
      outcome === "demo-reset" ? (
        <div class="outcome-line" data-outcome="demo-reset">
          <h2
            class="demo-reset-outcome-heading"
            tabindex="-1"
            autofocus
          >
            {DEMO_POLL_COPY.resetSuccessHeading}
          </h2>
          <p>{outcomeCopy[outcome]}</p>
        </div>
      ) : outcome ? (
        <p
          class="outcome-line"
          data-outcome={outcome === "created" ? "created" : outcome}
          tabindex="-1"
          autofocus
        >
          {outcomeCopy[outcome]}
        </p>
      ) : null
    }

    <section
      class="creator-list-region"
      aria-labelledby="creator-list-heading"
      data-creator-list
    >
      <div class="list-region-header">
        <h2 id="creator-list-heading" class="list-heading">Your Polls</h2>
        <a class="list-create-link" href="/creator/new">CREATE A POLL</a>
      </div>
      {
        listCards.length === 0 ? (
          <p class="empty-state">
            No Polls yet. The empty state, working as intended.
          </p>
        ) : (
          <ul class="poll-list" data-poll-list>
            {listCards.map((card) => (
              <li>
                <PollCard viewModel={card} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section
      class="creator-detail-region"
      aria-labelledby="poll-detail-heading"
      data-creator-detail
    >
      {
        poll && detailStatus ? (
          <>
            <p class="detail-status" data-detail-status>
              <LiveIndicator status={detailStatus}>
                <span>{formatVoteTotal(voterCount)}</span>
                <span aria-hidden="true"> · </span>
              </LiveIndicator>
              {listingState && (
                <>
                  <span aria-hidden="true"> · </span>
                  <ListingBadge state={listingState} />
                </>
              )}
            </p>
            <h1 id="poll-detail-heading">{poll.question}</h1>
            {formError && (
              <p class="form-error" tabindex="-1" autofocus>
                {formError}
              </p>
            )}

            <section class="link-block" aria-labelledby="poll-link-label">
              <p class="group-label" id="poll-link-label">POLL LINK</p>
              {canonicalUrl && <ShareAction canonicalUrl={canonicalUrl} />}
              <p class="helper-note">
                This is the link you'll share when voting opens. Its reference
                never changes.
              </p>
              {deadlineNote && <p class="helper-note">{deadlineNote}</p>}
            </section>

            <form
              method="post"
              action={detailPath}
              class="lifecycle-form"
              data-edit-poll-form={!definitionLocked ? true : undefined}
              data-edit-description-form={definitionLocked ? true : undefined}
              data-poll-definition-form
              novalidate
            >
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <PollDefinitionFields
                values={formValues}
                fieldErrors={fieldErrors}
                optionNote={optionNote}
                pollTypeLabel={poll.pollType.replaceAll("_", " ").toUpperCase()}
                locked={definitionLocked}
                lockMessage={
                  definitionLocked
                      ? LIFECYCLE_COPY.definitionLocked
                      : null
                }
                lockedSlots={meetingSlotRows}
                lockedTimeZone={creatorMeetingTimeZone}
                showSave={true}
                saveLabel="SAVE CHANGES"
              />
            </form>

            {
              creatorMeetingResults && (
                <AvailabilityTally
                  meeting={creatorMeetingResults.meeting}
                  status={creatorMeetingResults.status}
                  creatorTimeZone={creatorMeetingTimeZone}
                  liveEndpoint={`/${creatorMeetingResults.canonicalReference}/results/live`}
                  initialValidator={creatorMeetingResults.validator}
                  initialRenderAtMs={nowMs}
                />
              )
            }

            <form
              method="post"
              action={detailPath}
              class="lifecycle-form security-form"
              data-security-toggles
              novalidate
            >
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <fieldset class="field-block">
                <legend class="group-label">SECURITY TOGGLES</legend>
                {
                  securityVotesIn && (
                    <p class="security-lock-note" data-security-lock-note>
                      {SECURITY_COPY.locked}
                    </p>
                  )
                }
                <div class="security-toggle-list">
                  {
                    SECURITY_TOGGLES.map((key) => {
                      const on = securityValues[key];
                      const locked = securityVotesIn && on;
                      return (
                        <SecurityToggle
                          id={`detail-security-${key}`}
                          name={key}
                          label={SECURITY_TOGGLE_META[key].name}
                          description={SECURITY_TOGGLE_META[key].description}
                          checked={on}
                          locked={locked}
                        />
                      );
                    })
                  }
                </div>
              </fieldset>
              <div class="security-save">
                <ButtonSecondary type="submit" name="intent" value="update-security">
                  SAVE SECURITY
                </ButtonSecondary>
              </div>
            </form>

            {
              listingState === "delisted" ? (
                <section
                  class="lifecycle-form listing-form listing-readonly"
                  aria-labelledby="detail-listing-heading"
                  data-listing-readonly
                >
                  <h2 class="group-label" id="detail-listing-heading">
                    WHO CAN FIND IT
                  </h2>
                  <div
                    class="listing-readonly-row"
                    role="group"
                    aria-labelledby="detail-listing-state"
                    aria-describedby="detail-listing-description"
                  >
                    <p class="listing-readonly-state" id="detail-listing-state">
                      DELISTED
                    </p>
                    <p
                      class="listing-readonly-copy"
                      id="detail-listing-description"
                    >
                      {DELISTED_CREATOR_COPY}
                    </p>
                  </div>
                </section>
              ) : (
                <form
                  method="post"
                  action={detailPath}
                  class="lifecycle-form listing-form"
                  data-listing-control
                  novalidate
                >
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <fieldset
                    class="field-block"
                    aria-describedby={fieldErrors.listing ? "detail-listing-error" : undefined}
                  >
                    <legend class="group-label">WHO CAN FIND IT</legend>
                    <div class="listing-choices">
                      {LISTING_CHOICES.map((choice) => (
                        <PollOption
                          id={`detail-listing-${choice.value}`}
                          name="listing"
                          value={choice.value}
                          label={choice.label}
                          description={choice.description}
                          checked={listingState === choice.value}
                        />
                      ))}
                    </div>
                    {fieldErrors.listing && (
                      <p class="field-error" id="detail-listing-error">
                        {fieldErrors.listing}
                      </p>
                    )}
                  </fieldset>
                  <div class="listing-save">
                    <ButtonSecondary type="submit" name="intent" value="update-listing">
                      SAVE LISTING
                    </ButtonSecondary>
                  </div>
                </form>
              )
            }

            <div class="lifecycle-actions">
              {
                detailStatus === "open" && (
                  <form method="post" action={detailPath}>
                    <input type="hidden" name="csrf_token" value={csrfToken} />
                    <ButtonSecondary type="submit" name="intent" value="close">
                      CLOSE POLL
                    </ButtonSecondary>
                  </form>
                )
              }
              {
                demoResetPolicyEligible && (
                  <ButtonSecondary
                    href={demoResetEmpty ? undefined : `${detailPath}?confirm=reset-demo`}
                    id="reset-demo-poll-invoker"
                    disabled={demoResetEmpty}
                    aria-haspopup={demoResetEmpty ? undefined : "dialog"}
                    aria-controls={demoResetEmpty ? undefined : "reset-demo-poll-overlay"}
                    data-overlay-open-for={demoResetEmpty ? undefined : "reset-demo-poll-overlay"}
                  >
                    {demoResetEmpty
                      ? DEMO_POLL_COPY.resetDisabled
                      : DEMO_POLL_COPY.resetTrigger}
                  </ButtonSecondary>
                )
              }
              <ButtonSecondary
                href={`${detailPath}?confirm=delete`}
                id="delete-poll-invoker"
                aria-haspopup="dialog"
                aria-controls="delete-poll-overlay"
                data-overlay-open-for="delete-poll-overlay"
              >
                DELETE POLL
              </ButtonSecondary>
              <p class="results-link-row">
                <ButtonSecondary href={`/${poll.canonicalReference}/results`}>
                  VIEW LIVE RESULTS
                </ButtonSecondary>
              </p>
              {poll.pollType === "multiple_choice" && (
                <p class="export-link-row">
                  <ButtonSecondary
                    href={`${detailPath}/export.csv`}
                    data-export-csv
                  >
                    EXPORT CSV
                  </ButtonSecondary>
                  <ButtonSecondary
                    href={`${detailPath}/export.xlsx`}
                    data-export-xlsx
                  >
                    EXPORT XLSX
                  </ButtonSecondary>
                </p>
              )}
            </div>

            <Overlay
              id="reset-demo-poll-overlay"
              open={confirmResetDemo}
              titleId="reset-demo-poll-title"
              descriptionId="reset-demo-poll-description"
              title={DEMO_POLL_COPY.resetTitle}
            >
              <p slot="description">{DEMO_POLL_COPY.resetBody}</p>
              <div slot="actions" class="overlay-action-row">
                <ButtonSecondary href={detailPath} data-overlay-cancel={true}>
                  {DEMO_POLL_COPY.resetCancel}
                </ButtonSecondary>
                <form
                  method="post"
                  action={detailPath}
                  data-reset-demo-form
                  data-pending-label={DEMO_POLL_COPY.resetPending}
                >
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <ButtonDestructive type="submit" name="intent" value="reset-demo">
                    {DEMO_POLL_COPY.resetConfirm}
                  </ButtonDestructive>
                </form>
              </div>
            </Overlay>

            <Overlay
              id="delete-poll-overlay"
              open={confirmDelete}
              titleId="delete-poll-title"
              descriptionId="delete-poll-description"
              title={deleteHeading}
            >
              <p slot="description">{deleteBody}</p>
              <div slot="actions" class="overlay-action-row">
                <ButtonSecondary
                  href={detailPath}
                  data-overlay-cancel={true}
                >
                  CANCEL
                </ButtonSecondary>
                <form method="post" action={detailPath}>
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <ButtonDestructive type="submit" name="intent" value="delete">
                    DELETE POLL
                  </ButtonDestructive>
                </form>
              </div>
            </Overlay>
          </>
        ) : (
          <h1
            id="poll-detail-heading"
            class="outcome-line"
            tabindex="-1"
            autofocus
          >
            This Poll doesn't exist.
          </h1>
        )
      }
    </section>
  </main>
  {
    listCards.some((card) => card.metadata.closing.kind === "absolute") && (
      <script src="../../../scripts/creator-dashboard.ts"></script>
    )
  }
  {
    poll && (
      <>
        <script src="../../../scripts/edit-poll-form.ts"></script>
        <script src="../../../scripts/overlay.ts"></script>
        <script src="../../../scripts/share-action.ts"></script>
      </>
    )
  }
  {
    creatorMeetingResults?.status === "open" && (
      <script src="../../../scripts/meeting-results-live.ts"></script>
    )
  }
</BaseLayout>

<style>
  .creator-surface {
    width: min(100%, var(--space-measure));
    margin-inline: auto;
    padding: var(--space-8) var(--space-margin-mobile) var(--space-section-gap);
  }

  .creator-list-region {
    margin-bottom: var(--space-10);
  }

  .list-region-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .list-heading {
    margin: 0;
    font-family: var(--font-human);
    font-size: var(--type-heading-md-size);
    font-weight: 400;
    line-height: var(--type-heading-md-lh);
  }

  .list-create-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
    text-decoration: none;
  }

  .list-create-link:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .empty-state {
    margin: 0;
    color: var(--color-dim);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .poll-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcome-line {
    margin: 0 0 var(--space-6);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-lh);
  }

  .demo-reset-outcome-heading,
  .outcome-line > p {
    margin: 0;
  }

  .demo-reset-outcome-heading {
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-lg-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
  }

  .detail-status {
    margin: 0 0 var(--space-3);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-human);
    font-size: var(--type-heading-lg-size);
    font-weight: 400;
    line-height: var(--type-heading-lg-lh);
  }

  .link-block {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-2);
  }

  .group-label {
    margin: 0;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
  }

  .helper-note {
    margin: 0;
    color: var(--color-dim);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .lifecycle-form {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-8);
  }

  .security-form .field-block,
  .listing-form .field-block {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: none;
  }

  .security-form .group-label,
  .listing-form .group-label {
    display: block;
    padding: 0;
    color: var(--color-dim);
    font-family: var(--font-machine);
    font-size: var(--type-label-caps-size);
    line-height: var(--type-label-caps-lh);
    letter-spacing: var(--type-label-caps-ls);
    text-transform: uppercase;
  }

  .security-toggle-list {
    display: grid;
  }

  .security-lock-note {
    margin: 0 0 var(--space-2);
    color: var(--color-dim);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .security-save {
    margin-top: var(--space-2);
  }

  .listing-choices {
    display: grid;
  }

  .listing-readonly-row {
    display: grid;
    gap: var(--space-1);
    min-height: 44px;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--space-hairline) solid var(--color-rule);
    border-radius: var(--rounded-default);
    box-sizing: border-box;
  }

  .listing-readonly-state,
  .listing-readonly-copy {
    margin: 0;
  }

  .listing-readonly-state {
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .listing-readonly-copy {
    color: var(--color-text);
    font-size: var(--type-body-size);
    line-height: var(--type-body-lh);
  }

  .listing-save {
    margin-top: var(--space-2);
  }

  .field-error {
    margin: 0;
    color: var(--color-alarm);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  .lifecycle-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .results-link-row,
  .export-link-row {
    margin: 0;
  }

  .export-link-row {
    display: flex;
    gap: var(--space-3);
  }

  .export-link-row > :global(.btn-secondary) {
    flex: 1 1 0;
    min-width: 0;
    padding-inline: var(--space-2);
    white-space: nowrap;
  }

  .form-error {
    margin: 0 0 var(--space-4);
    color: var(--color-alarm);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
  }

  @media (min-width: 640px) {
    .creator-surface {
      padding-inline: var(--space-margin-desktop);
    }
  }

  @media (min-width: 1024px) {
    .creator-surface {
      display: grid;
      grid-template-columns: 320px 1fr;
      column-gap: var(--space-8);
      align-items: start;
      width: 100%;
      max-width: none;
    }

    .creator-list-region {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .creator-detail-region {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: var(--space-measure);
      min-width: 0;
    }

    .has-created-outcome > .outcome-line {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      max-width: var(--space-measure);
    }

    .has-created-outcome > .creator-list-region {
      grid-row: 1 / span 2;
    }

    .has-created-outcome > .creator-detail-region {
      grid-row: 2;
    }
  }
</style>
