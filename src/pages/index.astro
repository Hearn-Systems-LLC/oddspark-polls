---
import BaseLayout from "../layouts/base-layout.astro";
import ButtonPrimary from "../components/button-primary.astro";
// ?raw inlines the file at build time — the served HTML carries a value
// provably derived from the canonical token source.
import tokensCss from "../styles/tokens.css?raw";

const method = Astro.request.method;
if (method !== "GET" && method !== "HEAD") {
  return new Response("Method not allowed.", {
    status: 405,
    headers: { allow: "GET, HEAD" },
  });
}

const solarHex = tokensCss.match(
  /--color-solar-dark:\s*(#[0-9a-fA-F]{3,8})\s*;/,
)?.[1];
if (!solarHex) throw new Error("tokens.css: --color-solar-dark not found");

const validatedPath = "/";
const canonicalUrl = new URL(validatedPath, Astro.url.origin).href;
---

<BaseLayout
  title="Oddspark Polls — trustworthy casual polls"
  description="Create, discover, and vote in trustworthy casual polls with transparent security and no subscription wall."
  canonicalUrl={canonicalUrl}
>
  <div class="site-shell">
    <header class="site-header">
      <div>
        <p class="label-caps">polls.oddspark.dev</p>
        <h1 class="site-title">oddspark polls</h1>
        <p class="site-tagline">
          Trustworthy casual polls — multiple-choice, ranked, image, meeting.
          Free. No subscription.
        </p>
      </div>
      <button
        type="button"
        class="mode-toggle"
        data-mode-toggle
        aria-pressed="false"
      >
        Toggle mode
      </button>
    </header>

    <main class="landing-page">
      <section class="landing-block">
        <p class="landing-statement" data-landing-statement>Oddspark Polls is where a casual question gets an honest answer — multiple-choice, ranked, image, and meeting polls, with vote security and no subscription wall.</p>
      </section>

      <hr class="rule" />

      <section class="landing-block" data-landing-build-account>
        <h2 class="label-caps landing-label">How it's built</h2>
        <p class="landing-build-copy" data-landing-build-copy>Runs on Cloudflare Workers, server-rendered by Astro. Polls and votes live in D1; images live in R2. Sign-in is Better Auth with Google or GitHub. Turnstile checks the vote; rate limiting checks the rush. The code is public — see the repository.</p>
        <a
          class="label-caps landing-text-link"
          href="https://github.com/Hearn-Systems-LLC/oddspark-polls"
        >
          View repository
        </a>
        <!-- Token-derived smoke marker asserted by the staging smoke check -->
        <p
          class="label-caps"
          data-smoke-marker="oddspark-token-solar"
          data-token-solar={solarHex}
        >
          smoke · solar · {solarHex}
        </p>
      </section>

      <hr class="rule" />

      <section class="landing-block" aria-labelledby="landing-create-label">
        <h2 class="label-caps landing-label" id="landing-create-label">Create</h2>
        <ButtonPrimary href="/creator/new">Create a Poll</ButtonPrimary>
      </section>

      <hr class="rule" />

      <section class="landing-block" aria-labelledby="landing-discover-label">
        <h2 class="label-caps landing-label" id="landing-discover-label">Browse</h2>
        <a class="label-caps landing-text-link" href="/discover">
          Discover Polls
        </a>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .landing-page {
    padding-bottom: var(--space-section-gap);
  }

  .landing-block {
    margin: 0;
  }

  .landing-statement {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-human);
    font-size: var(--type-display-mobile-size);
    font-weight: 400;
    line-height: var(--type-display-mobile-lh);
    letter-spacing: var(--type-display-ls);
  }

  .landing-label {
    margin: 0 0 var(--space-4);
  }

  .landing-build-copy {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-machine);
    font-size: var(--type-body-lg-size);
    line-height: var(--type-body-lg-lh);
  }

  .landing-text-link {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-4);
    padding-block: var(--space-4);
    color: var(--color-entropy);
    text-decoration: none;
  }

  .landing-text-link:hover {
    color: var(--color-text);
  }

  [data-smoke-marker="oddspark-token-solar"] {
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 640px) {
    .landing-statement {
      font-size: var(--type-display-size);
      line-height: var(--type-display-lh);
    }
  }
</style>
