---
import BaseLayout from "../layouts/base-layout.astro";
import ButtonPrimary from "../components/button-primary.astro";
import ButtonSecondary from "../components/button-secondary.astro";
import Input from "../components/input.astro";
import PollOption from "../components/poll-option.astro";
import ResultsBar from "../components/results-bar.astro";
import Overlay from "../components/overlay.astro";
// ?raw inlines the file at build time — the served HTML carries a value
// provably derived from the canonical token source.
import tokensCss from "../styles/tokens.css?raw";

const solarHex = tokensCss.match(
  /--color-solar-dark:\s*(#[0-9a-fA-F]{3,8})\s*;/,
)?.[1];
if (!solarHex) throw new Error("tokens.css: --color-solar-dark not found");
---

<BaseLayout title="oddspark polls — foundation">
  <div class="site-shell">
    <header class="site-header">
      <div>
        <p class="label-caps">polls.oddspark.dev</p>
        <h1 class="site-title">oddspark polls</h1>
        <p class="site-tagline">
          Trustworthy casual polls — multiple-choice, ranked, image, meeting.
          Free. No subscription.
        </p>
      </div>
      <button
        type="button"
        class="mode-toggle"
        data-mode-toggle
        aria-pressed="false"
      >
        Toggle mode
      </button>
    </header>

    <main>
      <section class="section">
        <h2 class="section-title">Foundation status</h2>
        <p>
          Deployable skeleton, creator sign-in, multiple-choice poll
          creation, voting, and visibility-aware results are live. This
          page proves the design-token system, primitives, and deploy gate.
        </p>
        <!-- Token-derived smoke marker asserted by the staging smoke check -->
        <p class="label-caps" data-smoke-marker="oddspark-token-solar" data-token-solar={solarHex}>
          smoke · solar · {solarHex}
        </p>
      </section>

      <hr class="rule" />

      <section class="section">
        <h2 class="section-title">Buttons</h2>
        <div class="stack" style="flex-direction: row; flex-wrap: wrap; gap: var(--space-3);">
          <ButtonPrimary type="button">Vote</ButtonPrimary>
          <ButtonSecondary type="button">Share</ButtonSecondary>
          <ButtonPrimary type="button" disabled>Counting…</ButtonPrimary>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Input</h2>
        <Input
          id="demo-question"
          name="question"
          label="Poll question"
          placeholder="What should we ship next?"
        />
      </section>

      <section class="section">
        <h2 class="section-title">Poll options</h2>
        <div class="stack" style="gap: 0;">
          <PollOption
            id="opt-a"
            name="demo"
            value="a"
            label="Multiple choice"
            checked
          />
          <PollOption id="opt-b" name="demo" value="b" label="Ranked choice" />
          <PollOption id="opt-c" name="demo" value="c" label="Image poll" />
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Results bars</h2>
        <div class="stack" style="gap: var(--space-1);">
          <ResultsBar label="Multiple choice" percent={47} count={122} leader />
          <ResultsBar label="Ranked choice" percent={31} count={80} />
          <ResultsBar label="Image poll" percent={22} count={57} />
        </div>
      </section>

      <!-- Overlay primitive present but closed; open=false demonstrates token-bound structure without trapping focus -->
      <Overlay open={false} title="Confirm">
        <p>Overlay primitive is wired; closed by default on this page.</p>
      </Overlay>
    </main>
  </div>
</BaseLayout>
