---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/base-layout.astro";
import LandingIntro from "../components/landing-intro.astro";
import PollVotingSurface from "../components/poll-voting-surface.astro";
import SiteHeader from "../components/site-header.astro";
import {
  deliverPollVotingSurface,
  serializeDeliveryCookieEffect,
  VOTE_FLASH_COOKIE_NAME,
} from "../lib/poll-delivery";
import { VOTER_COOKIE_NAME } from "../adapters/digest/index";
import {
  DEMO_POLL_COPY,
  isDemoPollCompatible,
  validateDemoPollReference,
} from "../modules/polls/demo-poll";
import tokensCss from "../styles/tokens.css?raw";

Astro.response.headers.set("cache-control", "private, no-store");
const configured = validateDemoPollReference(env.DEMO_POLL_REFERENCE);
const reference = configured.ok ? configured.value : "";
const delivery = await deliverPollVotingSurface({
  reference,
  request: Astro.request,
  env,
  principalUserId: Astro.locals.principal?.userId ?? null,
  requestContext: Astro.locals.requestContext ?? null,
  voterCookie: Astro.cookies.get(VOTER_COOKIE_NAME)?.value ?? null,
  flashCookie: Astro.cookies.get(VOTE_FLASH_COOKIE_NAME)?.value ?? null,
  formAction: "/",
  successRedirect: "/",
  includeEditableTally: true,
  allowCanonicalCaseRedirect: false,
  operationalUnavailable: true,
  isCompatible: (poll) => configured.ok && isDemoPollCompatible(poll),
  remapReplacementRace: true,
});

for (const [name, value] of Object.entries(delivery.headers)) {
  Astro.response.headers.set(name, value);
}
if (delivery.response) {
  const responseHeaders = new Headers(delivery.response.headers);
  delivery.cookies.forEach((effect) =>
    responseHeaders.append("set-cookie", serializeDeliveryCookieEffect(effect)),
  );
  return new Response(delivery.response.body, {
    status: delivery.response.status,
    headers: responseHeaders,
  });
}
if (Astro.request.method === "HEAD") {
  const responseHeaders = new Headers(delivery.headers);
  delivery.cookies.forEach((effect) =>
    responseHeaders.append("set-cookie", serializeDeliveryCookieEffect(effect)),
  );
  return new Response(null, {
    status: delivery.status,
    headers: responseHeaders,
  });
}
delivery.cookies.forEach((effect) =>
  Astro.response.headers.append("set-cookie", serializeDeliveryCookieEffect(effect)),
);
Astro.response.status = delivery.status;

const solarHex = tokensCss.match(/--color-solar-dark:\s*(#[0-9a-fA-F]{3,8})\s*;/)?.[1];
if (!solarHex) throw new Error("tokens.css: --color-solar-dark not found");

const canonicalUrl = new URL("/", Astro.url.origin).href;
const state = delivery.state;
const unavailable = delivery.unavailable || state === null;
const outcomeBearing = unavailable || state?.outcome !== null;
const regionOrder = outcomeBearing ? ["demo", "intro"] : ["intro", "demo"];
const title = unavailable
  ? DEMO_POLL_COPY.unavailableTitle
  : state?.outcome
    ? `${state.outcome.titlePrefix} — ${state.poll.question}`
    : "Oddspark Polls — trustworthy casual polls";
---

<BaseLayout
  title={title}
  description="Create, discover, and vote in trustworthy casual polls with transparent security and no subscription wall."
  canonicalUrl={canonicalUrl}
>
  <div class="site-shell">
    <SiteHeader />
    <main class="landing-page">
      {
        regionOrder.map((region) =>
          region === "intro" ? (
            <LandingIntro solarHex={solarHex} />
          ) : unavailable ? (
            <section class="demo-unavailable" data-demo-region aria-labelledby="demo-unavailable-heading">
              <h1 id="demo-unavailable-heading" tabindex="-1" autofocus>{DEMO_POLL_COPY.unavailableHeading}</h1>
              <p>{DEMO_POLL_COPY.unavailableBody}</p>
              <a class="label-caps landing-text-link" href="/">{DEMO_POLL_COPY.retry}</a>
            </section>
          ) : state ? (
            <section class="landing-demo" data-demo-region aria-label="Live Demo Poll">
              <PollVotingSurface
                delivery={state}
                formAction="/"
                canonicalUrl={`${Astro.url.origin}/${state.poll.canonicalReference}`}
                liveEndpoint={`/${encodeURIComponent(reference)}/results/live`}
                turnstileSiteKey={env.TURNSTILE_SITE_KEY}
                embedded
              />
            </section>
          ) : null,
        )
      }

      <section class="landing-block" aria-labelledby="landing-create-label">
        <h2 class="label-caps landing-label" id="landing-create-label">Create</h2>
        <a class="label-caps landing-text-link" href="/creator/new">Create a Poll</a>
      </section>

      <hr class="rule" />

      <section class="landing-block" aria-labelledby="landing-discover-label">
        <h2 class="label-caps landing-label" id="landing-discover-label">Browse</h2>
        <a class="label-caps landing-text-link" href="/discover">Discover Polls</a>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .landing-page { padding-bottom: var(--space-section-gap); }
  .landing-block { margin: 0; }
  .landing-demo, .demo-unavailable { margin: 0; }
  .landing-demo::after, .demo-unavailable::after { content: ""; display: block; margin-block: var(--space-10); border-bottom: var(--space-hairline) solid var(--color-rule); }
  .demo-unavailable h1 { margin: 0 0 var(--space-4); color: var(--color-alarm); font-family: var(--font-machine); font-size: var(--type-label-caps-lg-size); line-height: var(--type-label-caps-lh); letter-spacing: var(--type-label-caps-ls); }
  .demo-unavailable h1:focus { outline: var(--focus-outline); outline-offset: var(--focus-outline-offset); }
  .demo-unavailable p { margin: 0; font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-lh); }
  .landing-label { margin: 0 0 var(--space-4); }
  .landing-text-link { display: inline-flex; align-items: center; min-height: 48px; margin-top: var(--space-4); color: var(--color-entropy); text-decoration: none; }
  .landing-text-link:hover { color: var(--color-text); }
</style>
